{
  "extends": "@pathfinder/config/typescript/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-local-staging/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
