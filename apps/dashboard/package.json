{
  "name": "@pathfinder/dashboard",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/sync-character-assets.mjs && next build && node ../../scripts/copy-next-standalone-assets.mjs",
    "dev": "node ../../scripts/sync-character-assets.mjs && next dev --port 3001",
    "lint": "eslint --config ../../packages/config/eslint/nextjs.js \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"instrumentation*.ts\" \"sentry.*.config.ts\" \"middleware.ts\" \"next.config.ts\" \"tailwind.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:billing-browser": "playwright test --config playwright.config.ts",
    "test:visual-browser": "playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.3",
    "@hookform/resolvers": "^5.2.2",
    "@pathfinder/api": "workspace:*",
    "@pathfinder/billing": "workspace:*",
    "@pathfinder/config": "workspace:*",
    "@pathfinder/contracts": "workspace:*",
    "@pathfinder/db": "workspace:*",
    "@pathfinder/jobs": "workspace:*",
    "@pathfinder/ui": "workspace:*",
    "@sentry/nextjs": "10.69.0",
    "@tanstack/react-query": "^5.59.20",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "autoprefixer": "10.4.21",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.21",
    "postcss": "8.5.23",
    "qrcode.react": "^4.2.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-hook-form": "^7.66.0",
    "superjson": "^2.2.2",
    "svix": "^1.90.0",
    "tailwindcss": "3.4.17",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "axe-core": "4.11.2",
    "jsdom": "^26.1.0"
  }
}
