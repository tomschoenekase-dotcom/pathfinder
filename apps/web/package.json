{
  "name": "@pathfinder/web",
  "private": true,
  "scripts": {
    "build": "next build && node ../../scripts/copy-next-standalone-assets.mjs",
    "dev": "next dev --port 3000",
    "lint": "eslint --config ../../packages/config/eslint/nextjs.js \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"public/**/*.{js,ts,tsx}\" \"instrumentation*.ts\" \"sentry.*.config.ts\" \"middleware.ts\" \"next.config.ts\" \"tailwind.config.ts\" \"vitest.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.3",
    "@pathfinder/api": "workspace:*",
    "@pathfinder/config": "workspace:*",
    "@pathfinder/contracts": "workspace:*",
    "@pathfinder/db": "workspace:*",
    "@pathfinder/jobs": "workspace:*",
    "@pathfinder/ui": "workspace:*",
    "@sentry/nextjs": "10.69.0",
    "@tanstack/react-query": "^5.59.20",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "autoprefixer": "10.4.21",
    "lucide-react": "^0.511.0",
    "next": "15.5.21",
    "postcss": "8.5.23",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "superjson": "^2.2.2",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "jsdom": "^26.1.0"
  }
}
