{
  "name": "@pathfinder/workers",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "echo dev:workers",
    "embedding:freshness": "pnpm --dir ../../packages/db exec tsx ../../apps/workers/src/scripts/embedding-freshness.ts",
    "embedding:claim-repair": "pnpm --dir ../../packages/db exec tsx ../../apps/workers/src/scripts/embedding-claim-repair.ts",
    "jobs:terminal-redrive": "pnpm --dir ../../packages/db exec tsx ../../apps/workers/src/scripts/terminal-redrive.ts",
    "agent-bridge:run": "pnpm --dir ../../packages/db exec tsx ../../apps/workers/src/scripts/agent-bridge-runner.ts",
    "lint": "eslint --config ../../packages/config/eslint/base.js \"src/**/*.ts\"",
    "start": "node --require ./dist/sentry.js dist/bootstrap.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@pathfinder/ai": "workspace:*",
    "@pathfinder/analytics": "workspace:*",
    "@pathfinder/api": "workspace:*",
    "@pathfinder/config": "workspace:*",
    "@pathfinder/contracts": "workspace:*",
    "@pathfinder/db": "workspace:*",
    "@pathfinder/jobs": "workspace:*",
    "@sentry/node": "10.69.0",
    "bullmq": "^5.61.0",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.8.1",
    "openai": "^4.0.0",
    "resend": "^4.0.0",
    "sharp": "^0.35.3",
    "unzipper": "^0.12.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/unzipper": "^0.10.11",
    "tsup": "^8.5.1"
  }
}
