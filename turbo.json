{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", "**/.env.local"],
  "globalPassThroughEnv": [
    "VITEST_MAX_FORKS",
    "VITEST_MIN_FORKS",
    "VITEST_MAX_THREADS",
    "VITEST_MIN_THREADS",
    "TORCHIKO_BATCH_REAL_PREVIEW",
    "TORCHIKO_SCRIPT_TEST_CONCURRENCY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["CLERK_PUBLISHABLE_KEY", "CLERK_SECRET_KEY", "DATABASE_URL", "DIRECT_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
