# Host dependency and build-artifact directories — must NOT enter the
# Docker build context, otherwise pnpm install --frozen-lockfile inside the
# container cannot perform a clean Linux install (breaks Prisma CLI etc.)
node_modules/
.pnpm-store/
.corepack/
.corepack-bin/
.railway/

# Build artifacts / caches
.next/
dist/
.turbo/
coverage/
*.tsbuildinfo

# Env and secrets
.env
.env.local
*.env
*.env.local
**/.env
**/.env.*
**/*.env
**/*.env.*

# VCS and local tooling
.git/
.husky/
**/.claude/
