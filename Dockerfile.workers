FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

FROM base AS installer
WORKDIR /app
COPY . .
RUN ! find . -type f \( -name '.env' -o -name '.env.*' -o -name '*.env' -o -name '*.env.*' \) -print -quit | grep -q . \
  && ! find . -type d -name '.claude' -print -quit | grep -q .
RUN pnpm install --frozen-lockfile

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=installer /app ./
RUN pnpm --filter @pathfinder/db exec prisma generate
RUN pnpm --filter @pathfinder/workers build

CMD ["node", "--require", "./apps/workers/dist/sentry.js", "apps/workers/dist/bootstrap.js"]
