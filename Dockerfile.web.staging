FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

FROM base AS installer
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
ARG NEXT_PUBLIC_WEB_URL
COPY --from=installer /app ./
RUN pnpm --filter @pathfinder/db exec prisma generate
RUN pnpm characters:sync
RUN pnpm --filter @pathfinder/web build
RUN mkdir -p /app/prisma-engine \
  && cp /app/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma/client/libquery_engine-linux-musl-openssl-3.0.x.so.node /app/prisma-engine/query-engine.node
RUN pnpm --filter @pathfinder/db deploy /migration
RUN cd /migration && pnpm exec prisma generate --schema ./prisma/schema.prisma

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PRISMA_QUERY_ENGINE_LIBRARY=/app/prisma-engine/query-engine.node
ENV PATHFINDER_PRISMA_DIR=/migration/prisma
ENV PATHFINDER_PRISMA_CLI=/migration/node_modules/.bin/prisma
ENV PATHFINDER_STAGING_MIGRATION_APPROVAL=torchiko-staging-lineage-to-206-20260830

COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /app/prisma-engine/query-engine.node /app/prisma-engine/query-engine.node
COPY --from=builder --chown=node:node /migration /migration
COPY --from=builder --chown=node:node /app/scripts/run-staging-migration-predeploy.mjs /migration/scripts/run-staging-migration-predeploy.mjs
COPY --from=builder --chown=node:node /app/scripts/lib/staging-migration-admission.mjs /migration/scripts/lib/staging-migration-admission.mjs
COPY --from=builder --chown=node:node /app/scripts/lib/operator-cli-failure.mjs /migration/scripts/lib/operator-cli-failure.mjs

EXPOSE 8080
ENV HOSTNAME=0.0.0.0

WORKDIR /app/apps/web
USER node
CMD ["node", "server.js"]
