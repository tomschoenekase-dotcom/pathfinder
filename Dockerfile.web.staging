FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

FROM base AS installer
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
ARG NEXT_PUBLIC_WEB_URL
COPY --from=installer /app ./
RUN pnpm --filter @pathfinder/db exec prisma generate
RUN pnpm characters:sync
RUN pnpm --filter @pathfinder/web build
RUN pnpm --filter @pathfinder/db deploy /migration
RUN cd /migration && pnpm exec prisma generate --schema ./prisma/schema.prisma

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PATHFINDER_PRISMA_DIR=/migration/prisma
ENV PATHFINDER_PRISMA_CLI=/migration/node_modules/.bin/prisma
ENV PATHFINDER_STAGING_MIGRATION_APPROVAL=torchiko-staging-lineage-to-162-20260824

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@6.19.3_prisma@6.19.3_magicast@0.3.5_typescript@5.9.3__typescript@5.9.3/node_modules/.prisma/client/*.node ./node_modules/.pnpm/@prisma+client@6.19.3_prisma@6.19.3_magicast@0.3.5_typescript@5.9.3__typescript@5.9.3/node_modules/.prisma/client/
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@6.19.3_prisma@6.19.3_magicast@0.3.5_typescript@5.9.3__typescript@5.9.3/node_modules/.prisma/client/*.node ./apps/web/.next/server/
COPY --from=builder /migration /migration
COPY --from=builder /app/scripts/run-staging-migration-predeploy.mjs /migration/scripts/run-staging-migration-predeploy.mjs
COPY --from=builder /app/scripts/lib/staging-migration-admission.mjs /migration/scripts/lib/staging-migration-admission.mjs

EXPOSE 8080
ENV HOSTNAME=0.0.0.0

WORKDIR /app/apps/web
CMD ["node", "server.js"]
