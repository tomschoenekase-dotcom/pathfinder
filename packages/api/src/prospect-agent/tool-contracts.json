{
  "schemaVersion": 1,
  "tools": {
    "torchiko.prospects.search": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "stage": {
            "type": "string",
            "enum": [
              "DISCOVERED",
              "RESEARCHED",
              "NEEDS_REVIEW",
              "READY_FOR_OUTREACH",
              "CONTACTED",
              "FOLLOW_UP_DUE",
              "REPLIED",
              "CONVERSATION",
              "QUALIFIED",
              "PROPOSAL_DECISION",
              "WON",
              "LOST",
              "PARKED",
              "DO_NOT_CONTACT"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        }
      },
      "outputSchema": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "canonicalName", "venues", "contacts"],
          "properties": {
            "id": {
              "type": "string"
            },
            "canonicalName": {
              "type": "string"
            },
            "organizationType": {
              "type": ["string", "null"]
            },
            "relationshipTier": {
              "type": ["string", "null"]
            },
            "priority": {
              "type": ["integer", "null"]
            },
            "territory": {
              "type": ["object", "null"]
            },
            "opportunity": {
              "type": ["object", "null"]
            },
            "venues": {
              "type": "array",
              "maxItems": 3
            },
            "contacts": {
              "type": "array",
              "maxItems": 3
            }
          }
        }
      },
      "examples": [
        {
          "input": {
            "query": "science museum",
            "stage": "RESEARCHED",
            "limit": 10
          },
          "output": [
            {
              "id": "org_example",
              "canonicalName": "Example Science Museum",
              "organizationType": "MUSEUM",
              "relationshipTier": null,
              "priority": 0,
              "territory": null,
              "opportunity": null,
              "venues": [],
              "contacts": []
            }
          ]
        }
      ],
      "relatedTools": [
        "torchiko.prospects.get_intelligence",
        "torchiko.prospects.list_campaign_members"
      ]
    },
    "torchiko.prospects.get_intelligence": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId"],
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          }
        }
      },
      "outputSchema": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["prospect", "liveVenue"],
            "properties": {
              "prospect": {
                "type": "object"
              },
              "liveVenue": {
                "type": ["object", "null"]
              }
            }
          }
        ]
      },
      "examples": [
        {
          "input": {
            "organizationId": "org_example"
          },
          "output": {
            "prospect": {
              "id": "org_example",
              "canonicalName": "Example Science Museum"
            },
            "liveVenue": null
          }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.search",
        "torchiko.prospects.save_outreach_draft",
        "torchiko.prospects.ask_operator"
      ]
    },
    "torchiko.prospects.list_launch_assets": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId", "prospectVenueId"],
        "properties": {
          "organizationId": { "type": "string", "minLength": 1, "maxLength": 191 },
          "prospectVenueId": { "type": "string", "minLength": 1, "maxLength": 191 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["available", "hold"],
        "properties": {
          "available": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "tenantId",
                "venueId",
                "release",
                "publicUrl",
                "filename",
                "mimeType",
                "sizeBytes",
                "sha256"
              ],
              "properties": {
                "schema": {
                  "type": "string",
                  "enum": ["torchiko.venue-launch-asset/1", "torchiko.venue-launch-asset/2"]
                },
                "tenantId": { "type": "string" },
                "venueId": { "type": "string" },
                "release": { "type": "object" },
                "publicUrl": { "type": "string", "format": "uri" },
                "filename": { "type": "string" },
                "mimeType": {
                  "type": "string",
                  "enum": ["image/svg+xml", "image/png", "application/pdf"]
                },
                "sizeBytes": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "format": { "type": "string", "enum": ["PNG", "PDF"] },
                "generatorVersion": { "type": "string", "pattern": "^qr-print-v[0-9]+$" }
              }
            }
          },
          "hold": { "type": ["string", "null"] }
        }
      },
      "examples": [
        {
          "input": { "organizationId": "org_example", "prospectVenueId": "prospect_venue_example" },
          "output": {
            "available": [],
            "hold": "No current QR is available for an active converted venue."
          }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.select_launch_asset",
        "torchiko.prospects.get_intelligence"
      ]
    },
    "torchiko.prospects.select_launch_asset": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
