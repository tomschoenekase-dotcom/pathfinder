{
  "schemaVersion": 1,
  "tools": {
    "torchiko.prospects.search": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "type": "string", "maxLength": 200 },
          "stage": {
            "type": "string",
            "enum": [
              "DISCOVERED",
              "RESEARCHED",
              "NEEDS_REVIEW",
              "READY_FOR_OUTREACH",
              "CONTACTED",
              "FOLLOW_UP_DUE",
              "REPLIED",
              "CONVERSATION",
              "QUALIFIED",
              "PROPOSAL_DECISION",
              "WON",
              "LOST",
              "PARKED",
              "DO_NOT_CONTACT"
            ]
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
        }
      },
      "outputSchema": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "canonicalName", "venues", "contacts"],
          "properties": {
            "id": { "type": "string" },
            "canonicalName": { "type": "string" },
            "organizationType": { "type": ["string", "null"] },
            "relationshipTier": { "type": ["string", "null"] },
            "priority": { "type": ["integer", "null"] },
            "territory": { "type": ["object", "null"] },
            "opportunity": { "type": ["object", "null"] },
            "venues": { "type": "array", "maxItems": 3 },
            "contacts": { "type": "array", "maxItems": 3 }
          }
        }
      },
      "examples": [
        {
          "input": { "query": "science museum", "stage": "RESEARCHED", "limit": 10 },
          "output": [
            {
              "id": "org_example",
              "canonicalName": "Example Science Museum",
              "organizationType": "MUSEUM",
              "relationshipTier": null,
              "priority": 0,
              "territory": null,
              "opportunity": null,
              "venues": [],
              "contacts": []
            }
          ]
        }
      ],
      "relatedTools": [
        "torchiko.prospects.get_intelligence",
        "torchiko.prospects.list_campaign_members"
      ]
    },
    "torchiko.prospects.get_intelligence": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId"],
        "properties": { "organizationId": { "type": "string", "minLength": 1, "maxLength": 191 } }
      },
      "outputSchema": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["prospect", "liveVenue"],
            "properties": {
              "prospect": { "type": "object" },
              "liveVenue": { "type": ["object", "null"] }
            }
          }
        ]
      },
      "examples": [
        {
          "input": { "organizationId": "org_example" },
          "output": {
            "prospect": { "id": "org_example", "canonicalName": "Example Science Museum" },
            "liveVenue": null
          }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.search",
        "torchiko.prospects.save_outreach_draft",
        "torchiko.prospects.ask_operator"
      ]
    },
    "torchiko.prospects.list_campaign_members": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campaignId"],
        "properties": {
          "campaignId": { "type": "string", "minLength": 1, "maxLength": 191 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
        }
      },
      "outputSchema": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["id", "organization"],
          "properties": {
            "id": { "type": "string" },
            "organization": { "type": "object" },
            "venue": { "type": ["object", "null"] },
            "contact": { "type": ["object", "null"] },
            "drafts": { "type": "array", "maxItems": 1 }
          }
        }
      },
      "examples": [{ "input": { "campaignId": "campaign_example", "limit": 25 }, "output": [] }],
      "relatedTools": [
        "torchiko.prospects.search",
        "torchiko.prospects.get_intelligence",
        "torchiko.prospects.save_outreach_draft"
      ]
    },
    "torchiko.prospects.claim_research_job": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "leaseSeconds": { "type": "integer", "minimum": 60, "maximum": 1800, "default": 900 }
        }
      },
      "outputSchema": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["jobId", "claimToken", "leaseExpiresAt", "attemptId", "organization"],
            "properties": {
              "jobId": { "type": "string" },
              "claimToken": { "type": "string", "format": "uuid" },
              "leaseExpiresAt": { "type": "string", "format": "date-time" },
              "attemptId": { "type": "string" },
              "organization": { "type": "object" }
            }
          }
        ]
      },
      "examples": [{ "input": { "leaseSeconds": 900 }, "output": null }],
      "relatedTools": [
        "torchiko.prospects.complete_research_job",
        "torchiko.prospects.release_research_job",
        "torchiko.prospects.get_intelligence"
      ]
    },
    "torchiko.prospects.complete_research_job": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimToken", "outcome", "reason"],
        "properties": {
          "claimToken": { "type": "string", "format": "uuid" },
          "outcome": {
            "type": "string",
            "enum": ["RESEARCHED", "NEEDS_REVIEW", "BLOCKED", "CAP_REACHED", "SKIPPED"]
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "usage": { "type": "object", "default": {} },
          "costUsd": { "type": "number", "minimum": 0, "maximum": 10000 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["RESEARCHED", "NEEDS_REVIEW", "BLOCKED", "CAP_REACHED", "SKIPPED"]
          }
        }
      },
      "examples": [
        {
          "input": {
            "claimToken": "00000000-0000-4000-8000-000000000001",
            "outcome": "NEEDS_REVIEW",
            "reason": "Official contact role remains ambiguous",
            "usage": { "searches": 4 }
          },
          "output": { "id": "job_example", "status": "NEEDS_REVIEW" }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.claim_research_job",
        "torchiko.prospects.release_research_job",
        "torchiko.prospects.ask_operator"
      ]
    },
    "torchiko.prospects.release_research_job": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimToken", "reason"],
        "properties": {
          "claimToken": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["id", "status"],
        "properties": { "id": { "type": "string" }, "status": { "const": "QUEUED" } }
      },
      "examples": [
        {
          "input": {
            "claimToken": "00000000-0000-4000-8000-000000000001",
            "reason": "Bounded research window ended"
          },
          "output": { "id": "job_example", "status": "QUEUED" }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.claim_research_job",
        "torchiko.prospects.complete_research_job"
      ]
    },
    "torchiko.prospects.save_outreach_draft": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "subject", "textBody", "evidence", "template", "prompt"],
        "properties": {
          "memberId": { "type": "string", "minLength": 1, "maxLength": 191 },
          "subject": { "type": "string", "minLength": 1, "maxLength": 998 },
          "textBody": { "type": "string", "minLength": 1, "maxLength": 50000 },
          "htmlBody": { "type": "string", "maxLength": 100000 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["CRM_FIELD", "SOURCE_EVIDENCE", "WEBSITE_RESEARCH", "CORRESPONDENCE"]
                },
                "reference": { "type": "string", "minLength": 1, "maxLength": 500 },
                "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          },
          "template": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
          },
          "warnings": {
            "type": "array",
            "maxItems": 25,
            "default": [],
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" },
          "version": { "type": "integer" }
        }
      },
      "examples": [
        {
          "input": {
            "memberId": "member_example",
            "subject": "A visitor guide for Example Museum",
            "textBody": "Draft body for human review.",
            "evidence": [{ "kind": "CRM_FIELD", "reference": "organization.canonicalName" }],
            "template": { "id": "intro", "version": "1" },
            "prompt": { "id": "prospect-draft", "version": "1" },
            "warnings": []
          },
          "output": { "id": "draft_example", "status": "DRAFT", "version": 1 }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.get_intelligence",
        "torchiko.prospects.list_campaign_members",
        "torchiko.prospects.ask_operator"
      ]
    },
    "torchiko.prospects.ask_operator": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "question"],
        "properties": {
          "operationId": { "type": "string", "format": "uuid" },
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "context": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "urgency": {
            "type": "string",
            "enum": ["LOW", "NORMAL", "HIGH", "URGENT"],
            "default": "NORMAL"
          },
          "blocking": { "type": "boolean", "default": true },
          "evidence": { "type": "array", "maxItems": 20, "default": [] }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "replayed"],
        "properties": {
          "question": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string" } }
          },
          "replayed": { "type": "boolean" }
        }
      },
      "examples": [
        {
          "input": {
            "operationId": "00000000-0000-4000-8000-000000000002",
            "question": "Which verified contact should receive a draft?",
            "urgency": "NORMAL",
            "blocking": true,
            "evidence": []
          },
          "output": { "question": { "id": "question_example" }, "replayed": false }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.get_intelligence",
        "torchiko.prospects.complete_research_job",
        "torchiko.prospects.save_outreach_draft"
      ]
    }
  }
}
