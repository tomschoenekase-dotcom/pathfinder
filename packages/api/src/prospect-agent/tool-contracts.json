                  "tenantId",
                  "venueId",
                  "release",
                  "publicUrl",
                  "sha256",
                  "format",
                  "generatorVersion"
                ],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1, "maxLength": 191 },
                  "venueId": { "type": "string", "minLength": 1, "maxLength": 191 },
                  "release": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "id", "revisionSha256"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["NATIVE", "LEGACY"] },
                      "id": { "type": "string", "minLength": 1, "maxLength": 191 },
                      "revisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                    }
                  },
                  "publicUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "format": { "type": "string", "enum": ["PNG", "PDF"] },
                  "generatorVersion": { "type": "string", "pattern": "^qr-print-v[0-9]+$" }
                }
              }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "tenantId",
          "venueId",
          "release",
          "publicUrl",
          "filename",
          "mimeType",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "enum": ["torchiko.venue-launch-asset/1", "torchiko.venue-launch-asset/2"]
          },
          "tenantId": { "type": "string" },
          "venueId": { "type": "string" },
          "release": { "type": "object" },
          "publicUrl": { "type": "string", "format": "uri" },
          "filename": { "type": "string" },
          "mimeType": {
            "type": "string",
            "enum": ["image/svg+xml", "image/png", "application/pdf"]
          },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "format": { "type": "string", "enum": ["PNG", "PDF"] },
          "generatorVersion": { "type": "string", "pattern": "^qr-print-v[0-9]+$" }
        }
      },
      "examples": [
        {
          "input": {
            "organizationId": "org_example",
