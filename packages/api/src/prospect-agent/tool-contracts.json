    "torchiko.prospects.complete_research_job": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimToken", "outcome", "reason"],
        "properties": {
          "claimToken": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": ["RESEARCHED", "NEEDS_REVIEW", "BLOCKED", "CAP_REACHED", "SKIPPED"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "usage": {
            "type": "object",
            "default": {}
          },
          "costUsd": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["RESEARCHED", "NEEDS_REVIEW", "BLOCKED", "CAP_REACHED", "SKIPPED"]
          }
        }
      },
      "examples": [
        {
          "input": {
            "claimToken": "00000000-0000-4000-8000-000000000001",
            "outcome": "NEEDS_REVIEW",
            "reason": "Official contact role remains ambiguous",
            "usage": {
              "searches": 4
            }
          },
          "output": {
            "id": "job_example",
            "status": "NEEDS_REVIEW"
          }
        }
      ],
      "relatedTools": [
        "torchiko.prospects.claim_research_job",
        "torchiko.prospects.release_research_job",
        "torchiko.prospects.ask_operator"
      ]
    },
