    },
    "torchiko.prospects.save_outreach_draft": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "subject", "textBody", "evidence", "template", "prompt"],
        "properties": {
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 998
          },
          "textBody": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "htmlBody": {
            "type": "string",
            "maxLength": 100000
          },
          "launchAssetSelection": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["tenantId", "venueId", "release", "publicUrl", "sha256"],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1, "maxLength": 191 },
                  "venueId": { "type": "string", "minLength": 1, "maxLength": 191 },
                  "release": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "id", "revisionSha256"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["NATIVE", "LEGACY"] },
                      "id": { "type": "string", "minLength": 1, "maxLength": 191 },
                      "revisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                    }
                  },
                  "publicUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenantId",
                  "venueId",
                  "release",
                  "publicUrl",
                  "sha256",
                  "format",
                  "generatorVersion"
                ],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1, "maxLength": 191 },
                  "venueId": { "type": "string", "minLength": 1, "maxLength": 191 },
                  "release": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "id", "revisionSha256"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["NATIVE", "LEGACY"] },
                      "id": { "type": "string", "minLength": 1, "maxLength": 191 },
                      "revisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                    }
                  },
                  "publicUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "format": { "type": "string", "enum": ["PNG", "PDF"] },
                  "generatorVersion": { "type": "string", "pattern": "^qr-print-v[0-9]+$" }
                }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["CRM_FIELD", "SOURCE_EVIDENCE", "WEBSITE_RESEARCH", "CORRESPONDENCE"]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
