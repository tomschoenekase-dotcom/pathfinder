          },
          "output": {
            "schema": "torchiko.venue-launch-asset/2",
            "tenantId": "tenant_example",
            "venueId": "venue_example",
            "release": {
              "kind": "NATIVE",
              "id": "release_example",
              "revisionSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "publicUrl": "https://guide.example.com/venue/chat?source=qr",
            "filename": "torchiko-venue-qr.png",
            "mimeType": "image/png",
            "sizeBytes": 1234,
            "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "format": "PNG",
            "generatorVersion": "qr-print-v1"
          }
