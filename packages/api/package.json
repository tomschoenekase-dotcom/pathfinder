{
  "name": "@pathfinder/api",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.json",
    "dev": "echo dev:api",
    "lint": "eslint --config ../config/eslint/base.js \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@pathfinder/analytics": "workspace:*",
    "@pathfinder/ai": "workspace:*",
    "@pathfinder/auth": "workspace:*",
    "@pathfinder/config": "workspace:*",
    "@pathfinder/db": "workspace:*",
    "@pathfinder/jobs": "workspace:*",
    "@trpc/server": "^11.0.0",
    "ioredis": "^5.8.1",
    "superjson": "^2.2.2",
    "zod": "^3.0.0"
  }
}
