{
  "name": "@pathfinder/db",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./prospect-territories": "./src/helpers/prospect-territory-contract.ts",
    "./prospect-county-research": "./src/helpers/prospect-county-research-contract.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev": "echo dev:db",
    "lint": "eslint --config ../config/eslint/base.js \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@pathfinder/ai": "workspace:*",
    "@pathfinder/config": "workspace:*",
    "@pathfinder/contracts": "workspace:*",
    "@pathfinder/character-factory": "workspace:*",
    "@prisma/client": "^6.7.0",
    "hash-wasm": "^4.12.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "3.2.6",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
