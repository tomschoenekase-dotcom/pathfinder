model TenantMembership {
  id                           String                          @id @default(cuid())
  tenantId                     String                          @map("tenant_id")
  userId                       String                          @map("user_id")
  role                         TenantRole
  status                       MembershipStatus                @default(ACTIVE)
  invitedBy                    String?                         @map("invited_by")
  joinedAt                     DateTime?                       @map("joined_at")
  clerkEventTimestamp          BigInt                          @default(dbgenerated("(FLOOR(EXTRACT(EPOCH FROM CURRENT_TIMESTAMP) * 1000))::BIGINT")) @map("clerk_event_timestamp")
  clerkCursorIsCutoverBaseline Boolean                         @default(true) @map("clerk_cursor_is_cutover_baseline")
  welcomeEmailAttemptedAt      DateTime?                       @map("welcome_email_attempted_at")
  welcomeEmailDeliveredAt      DateTime?                       @map("welcome_email_delivered_at")
  createdAt                    DateTime                        @default(now()) @map("created_at")
  updatedAt                    DateTime                        @updatedAt @map("updated_at")
  tenant                       Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                         User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  supportRequesters            SupportRequest[]                @relation("support_request_requester_membership")
  supportRequestParticipations SupportRequestParticipant[]
  clientAssistantPreferences   ClientAssistantPreference[]     @relation("client_assistant_preference_membership")
  clientAssistantThreads       ClientAssistantThread[]         @relation("client_assistant_thread_membership")
  confirmedAssistantHandoffs   ClientAssistantSupportHandoff[] @relation("client_assistant_handoff_confirmer")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model AuditLog {
  id               String    @id @default(cuid())
  tenantId         String?   @map("tenant_id")
  actorType        ActorType @default(HUMAN) @map("actor_type")
  actorId          String    @map("actor_id")
  actorRole        String    @map("actor_role")
  agentIdentityId  String?   @map("agent_identity_id")
  agentRunId       String?   @map("agent_run_id")
  workerId         String?   @map("worker_id")
  systemJobId      String?   @map("system_job_id")
  integrationId    String?   @map("integration_id")
  credentialId     String?   @map("credential_id")
  approvalGrantId  String?   @map("approval_grant_id")
  capability       String?
  modelProvider    String?   @map("model_provider")
  modelName        String?   @map("model_name")
  idempotencyKey   String?   @map("idempotency_key")
  structuredReason Json?     @map("structured_reason")
  sourceReferences Json?     @map("source_references")
  action           String
  targetType       String    @map("target_type")
  targetId         String    @map("target_id")
  beforeState      Json?     @map("before_state")
  afterState       Json?     @map("after_state")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([actorType, actorId, createdAt])
  @@index([tenantId, agentRunId, createdAt])
  @@index([tenantId, workerId, createdAt])
  @@index([tenantId, approvalGrantId, createdAt])
  @@map("audit_logs")
}

model TenantFeatureFlag {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  flagKey  String   @map("flag_key")
  enabled  Boolean  @default(false)
  metadata Json     @default("{}")
  setBy    String   @map("set_by")
  setAt    DateTime @default(now()) @map("set_at")
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

/// Platform-owned plan-to-capability assignment. Billing may select planTier,
/// but it does not own or resolve product authorization.
model ProductPlanCapability {
  id         String   @id @default(cuid())
  planTier   String   @map("plan_tier") @db.VarChar(64)
  capability String   @db.VarChar(100)
  enabled    Boolean  @default(false)
  settings   Json     @default("{}")
  createdBy  String   @map("created_by") @db.VarChar(191)
  updatedBy  String   @map("updated_by") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([planTier, capability])
  @@index([capability, enabled])
  @@map("product_plan_capabilities")
}

enum ProductEntitlementEffect {
  GRANT
  DENY
}

enum ProductEntitlementOverrideKind {
  EXPLICIT
  TRIAL
  PROMOTION
  ADMIN
}

/// Time-bounded tenant or venue override. Rows are append-only authorization
/// evidence; the resolver selects the newest active venue row, then tenant row.
model ProductEntitlementOverride {
  id         String                         @id @default(cuid())
  tenantId   String                         @map("tenant_id")
  venueId    String?                        @map("venue_id")
  capability String                         @db.VarChar(100)
  effect     ProductEntitlementEffect
  kind       ProductEntitlementOverrideKind
  startsAt   DateTime                       @default(now()) @map("starts_at")
  endsAt     DateTime?                      @map("ends_at")
  settings   Json                           @default("{}")
  setBy      String                         @map("set_by") @db.VarChar(191)
  reason     String                         @db.VarChar(500)
  createdAt  DateTime                       @default(now()) @map("created_at")
  tenant     Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue      Venue?                         @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, venueId, capability, startsAt, createdAt])
  @@index([tenantId, capability, startsAt, createdAt])
  @@map("product_entitlement_overrides")
}

enum StripeEnvironmentMode {
  TEST
  LIVE
}

