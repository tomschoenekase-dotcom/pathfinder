  afterState            Json?         @map("after_state")
  actorId               String?       @map("actor_id")
  revertedFromId        String?       @map("reverted_from_id") @db.Uuid
  venuePackageId        String?       @map("venue_package_id")
  venuePackageItemKey   String?       @map("venue_package_item_key") @db.Uuid
  venuePackageAction    String?       @map("venue_package_action")
