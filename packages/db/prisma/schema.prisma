/// venueScopeKey is "__client__" for client scope or the exact venue id for
/// venue scope, providing one stable composite identity without nullable keys.
model AiScopedWorkloadConfigurationOverride {
  id                           String                                 @id @default(cuid())
  tenantId                     String                                 @map("tenant_id")
  venueId                      String?                                @map("venue_id")
  venueScopeKey                String                                 @map("venue_scope_key") @db.VarChar(191)
  scopeLevel                   AiConfigurationScopeLevel              @map("scope_level")
  workloadId                   String                                 @map("workload_id") @db.VarChar(100)
  enabled                      Boolean                                @default(false)
  primaryModelKey              String?                                @map("primary_model_key") @db.VarChar(100)
  primaryModelKeySet           Boolean                                @default(false) @map("primary_model_key_set")
  fallbackEnabled              Boolean?                               @map("fallback_enabled")
  fallbackEnabledSet           Boolean                                @default(false) @map("fallback_enabled_set")
  fallbackModelKeys            String[]                               @default([]) @map("fallback_model_keys")
  fallbackModelKeysSet         Boolean                                @default(false) @map("fallback_model_keys_set")
  timeoutMs                    Int?                                   @map("timeout_ms")
  timeoutMsSet                 Boolean                                @default(false) @map("timeout_ms_set")
  maxAttempts                  Int?                                   @map("max_attempts")
  maxAttemptsSet               Boolean                                @default(false) @map("max_attempts_set")
  maxOutputTokens              Int?                                   @map("max_output_tokens")
  maxOutputTokensSet           Boolean                                @default(false) @map("max_output_tokens_set")
  requestBudgetCeilingE8Usd    String?                                @map("request_budget_ceiling_e8_usd") @db.VarChar(40)
  requestBudgetCeilingE8UsdSet Boolean                                @default(false) @map("request_budget_ceiling_e8_usd_set")
  unsafeChangesEnabled         Boolean                                @default(false) @map("unsafe_changes_enabled")
  isTombstone                  Boolean                                @default(false) @map("is_tombstone")
  reason                       String                                 @db.VarChar(500)
  revision                     Int                                    @default(1)
  createdBy                    String                                 @map("created_by") @db.VarChar(191)
  updatedBy                    String                                 @map("updated_by") @db.VarChar(191)
  createdAt                    DateTime                               @default(now()) @map("created_at")
  updatedAt                    DateTime                               @updatedAt @map("updated_at")
  tenant                       Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                        Venue?                                 @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  history                      AiScopedWorkloadConfigurationHistory[]

  @@unique([tenantId, venueScopeKey, workloadId])
  @@unique([id, tenantId])
  @@index([tenantId, scopeLevel, enabled, isTombstone])
  @@index([tenantId, venueId])
  @@map("ai_scoped_workload_configuration_overrides")
}

/// Immutable tenant-owned evidence for every scoped override transition.
model AiScopedWorkloadConfigurationHistory {
  id         String                                @id @default(cuid())
  overrideId String                                @map("override_id")
  tenantId   String                                @map("tenant_id")
  venueId    String?                               @map("venue_id")
  scopeLevel AiConfigurationScopeLevel             @map("scope_level")
  workloadId String                                @map("workload_id") @db.VarChar(100)
  revision   Int
  action     AiConfigurationHistoryAction
  snapshot   Json
  actorId    String                                @map("actor_id") @db.VarChar(191)
  actorRole  String                                @map("actor_role") @db.VarChar(64)
  reason     String                                @db.VarChar(500)
  createdAt  DateTime                              @default(now()) @map("created_at")
  override   AiScopedWorkloadConfigurationOverride @relation(fields: [overrideId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  tenant     Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([overrideId, revision])
  @@index([tenantId, venueId, workloadId, createdAt])
  @@map("ai_scoped_workload_configuration_history")
