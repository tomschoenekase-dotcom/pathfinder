  MANUAL
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum StripeWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  APPLIED
  IGNORED
  QUARANTINED
  FAILED
}

enum BillingEventApplicationStatus {
  APPLIED
  IGNORED_STALE
  QUARANTINED
  FAILED
}

enum BillingReconciliationTrigger {
  SCHEDULED
  ON_DEMAND
  WEBHOOK_RECOVERY
}

enum BillingReconciliationRunStatus {
  RUNNING
  SUCCEEDED
  DRIFT_DETECTED
  FAILED
}

enum BillingAccessOverrideEffect {
  GRANT
  DENY
}

enum BillingAccessOverrideKind {
  MANUAL_PAYMENT
  COMPLIMENTARY
  PILOT
  GRACE_PERIOD
  PLATFORM_ADMIN
}

enum BillingCustomerRequestKind {
  CANCELLATION
  ADD_ON_INTEREST
}

enum BillingCustomerRequestStatus {
  OPEN
  PROCESSING
  COMPLETED
  DECLINED
  WITHDRAWN
