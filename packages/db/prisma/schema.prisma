  guestChatTurn             GuestChatTurn?               @relation("GuestChatTurnMessages", fields: [guestChatTurnId, tenantId, venueId, sessionId], references: [id, tenantId, venueId, sessionId], onDelete: Restrict, onUpdate: Restrict)
  askedEngagementResponses  EngagementQuestionResponse[] @relation("EngagementAskedMessage")
