/// A global workload-level override. Rows are staged and disabled by default.
/// Nullable values are paired with explicit *Set fields so "inherit" and an
/// intentional null remain distinct. No provider credentials belong here.
model AiWorkloadConfigurationOverride {
  id                           String                           @id @default(cuid())
  workloadId                   String                           @unique @map("workload_id") @db.VarChar(100)
  enabled                      Boolean                          @default(false)
  primaryModelKey              String?                          @map("primary_model_key") @db.VarChar(100)
  primaryModelKeySet           Boolean                          @default(false) @map("primary_model_key_set")
  fallbackEnabled              Boolean?                         @map("fallback_enabled")
  fallbackEnabledSet           Boolean                          @default(false) @map("fallback_enabled_set")
  fallbackModelKeys            String[]                         @default([]) @map("fallback_model_keys")
  fallbackModelKeysSet         Boolean                          @default(false) @map("fallback_model_keys_set")
  timeoutMs                    Int?                             @map("timeout_ms")
  timeoutMsSet                 Boolean                          @default(false) @map("timeout_ms_set")
  maxAttempts                  Int?                             @map("max_attempts")
  maxAttemptsSet               Boolean                          @default(false) @map("max_attempts_set")
  maxOutputTokens              Int?                             @map("max_output_tokens")
  maxOutputTokensSet           Boolean                          @default(false) @map("max_output_tokens_set")
  requestBudgetCeilingE8Usd    String?                          @map("request_budget_ceiling_e8_usd") @db.VarChar(40)
  requestBudgetCeilingE8UsdSet Boolean                          @default(false) @map("request_budget_ceiling_e8_usd_set")
  unsafeChangesEnabled         Boolean                          @default(false) @map("unsafe_changes_enabled")
  isTombstone                  Boolean                          @default(false) @map("is_tombstone")
  reason                       String                           @db.VarChar(500)
  revision                     Int                              @default(1)
  createdBy                    String                           @map("created_by") @db.VarChar(191)
  updatedBy                    String                           @map("updated_by") @db.VarChar(191)
  createdAt                    DateTime                         @default(now()) @map("created_at")
  updatedAt                    DateTime                         @updatedAt @map("updated_at")
  history                      AiWorkloadConfigurationHistory[]

  @@index([enabled, isTombstone])
  @@map("ai_workload_configuration_overrides")
}

/// Immutable evidence for every global workload override transition.
model AiWorkloadConfigurationHistory {
  id         String                          @id @default(cuid())
  overrideId String                          @map("override_id")
  workloadId String                          @map("workload_id") @db.VarChar(100)
  revision   Int
  action     AiConfigurationHistoryAction
  snapshot   Json
  actorId    String                          @map("actor_id") @db.VarChar(191)
  actorRole  String                          @map("actor_role") @db.VarChar(64)
  reason     String                          @db.VarChar(500)
  createdAt  DateTime                        @default(now()) @map("created_at")
  override   AiWorkloadConfigurationOverride @relation(fields: [overrideId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([overrideId, revision])
  @@index([workloadId, createdAt])
  @@map("ai_workload_configuration_history")
}

/// Client- and venue-scoped overrides retain a required tenant predicate.
