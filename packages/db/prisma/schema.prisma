model WeeklyReport {
  id                        String                     @id @default(cuid())
  tenantId                  String                     @map("tenant_id")
  venueId                   String                     @map("venue_id")
  weekStart                 DateTime                   @map("week_start")
  weekEnd                   DateTime                   @map("week_end")
  status                    WeeklyReportStatus         @default(GENERATING)
  title                     String                     @default("PathFinder Weekly Report")
  content                   String?
  answerCount               Int                        @default(0) @map("answer_count")
  sessionCount              Int                        @default(0) @map("session_count")
  error                     String?
  generatedAt               DateTime?                  @map("generated_at")
  publishedAt               DateTime?                  @map("published_at")
  createdBy                 String                     @map("created_by")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  executionLeaseToken       String?                    @map("execution_lease_token") @db.Uuid
  executionLeaseExpiresAt   DateTime?                  @map("execution_lease_expires_at")
  recoveryLineageToken      String?                    @map("recovery_lineage_token") @db.Uuid
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue                     Venue                      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  generationRequestDispatch GenerationRequestDispatch?

  @@unique([id, tenantId, venueId])
  @@index([venueId, weekStart])
  @@index([tenantId, venueId, weekStart])
  @@index([status])
  @@index([status, executionLeaseExpiresAt])
  @@map("weekly_reports")
}

model AnswerAnalysisSnapshot {
