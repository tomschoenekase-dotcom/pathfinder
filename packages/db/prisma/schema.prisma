  recordHash              String         @map("record_hash") @db.Char(64)
  rawPayload              Json           @map("raw_payload")
  normalizedPayload       Json           @map("normalized_payload")
  sourceStatus            String         @map("source_status") @db.VarChar(100)
  recordMetadata          Json           @default("{}") @map("record_metadata")
  processingStatus        String         @default("PENDING") @map("processing_status") @db.VarChar(32)
  claimToken              String?        @map("claim_token") @db.Uuid
  claimOwner              String?        @map("claim_owner") @db.VarChar(191)
  claimExpiresAt          DateTime?      @map("claim_expires_at")
  errorCode               String?        @map("error_code") @db.VarChar(100)
  errorMessage            String?        @map("error_message") @db.VarChar(2000)
