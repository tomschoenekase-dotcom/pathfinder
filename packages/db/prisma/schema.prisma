enum ExternalCredentialKind {
  MCP
  PARTNER_READ_API
}

enum ExternalCredentialHashAlgorithm {
  ARGON2ID
}

/// Dark credential record. `secretHash` is a one-way verifier; plaintext
/// credential material must never enter this database.
model ExternalAccessCredential {
  id                     String                               @id @default(cuid())
  tenantId               String                               @map("tenant_id")
  clientId               String                               @map("client_id")
  venueId                String?                              @map("venue_id")
  scopeKey               String                               @map("scope_key") @db.VarChar(191)
  kind                   ExternalCredentialKind
  label                  String                               @db.VarChar(200)
  capabilities           String[]
  secretPrefix           String                               @map("secret_prefix") @db.VarChar(24)
  secretHash             String                               @map("secret_hash") @db.VarChar(255)
  hashAlgorithm          ExternalCredentialHashAlgorithm      @default(ARGON2ID) @map("hash_algorithm")
  enabled                Boolean                              @default(false)
  expiresAt              DateTime?                            @map("expires_at")
  revokedAt              DateTime?                            @map("revoked_at")
  lastUsedAt             DateTime?                            @map("last_used_at")
  createdBy              String                               @map("created_by") @db.VarChar(191)
  createdAt              DateTime                             @default(now()) @map("created_at")
  updatedAt              DateTime                             @updatedAt @map("updated_at")
  tenant                 Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                  Venue?                               @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  rotationsFrom          ExternalCredentialRotation[]         @relation("rotation_from")
  rotationsTo            ExternalCredentialRotation[]         @relation("rotation_to")
  revocation             ExternalCredentialRevocation?
  operationReceipts      ExternalCredentialOperationReceipt[] @relation("credential_operation_result")
  priorOperationReceipts ExternalCredentialOperationReceipt[] @relation("credential_operation_previous")

  @@unique([id, tenantId, clientId, scopeKey], map: "external_credentials_exact_scope_key")
  @@unique([tenantId, kind, secretPrefix], map: "external_credentials_prefix_key")
  @@index([tenantId, clientId, venueId, kind, createdAt, id], map: "external_credentials_scope_created_idx")
  @@map("external_access_credentials")
}

enum ExternalCredentialOperationKind {
  ISSUE
  ROTATE
  REVOKE
}

/// Immutable replay evidence. It deliberately contains no plaintext secret or
/// recoverable secret material.
model ExternalCredentialOperationReceipt {
  operationId          String                          @id @map("operation_id") @db.Uuid
  operationHash        String                          @map("operation_hash") @db.Char(64)
  operationKind        ExternalCredentialOperationKind @map("operation_kind")
  tenantId             String                          @map("tenant_id")
  clientId             String                          @map("client_id")
  venueId              String?                         @map("venue_id")
  scopeKey             String                          @map("scope_key") @db.VarChar(191)
  credentialId         String                          @map("credential_id")
  previousCredentialId String?                         @map("previous_credential_id")
  actorId              String                          @map("actor_id") @db.VarChar(191)
  createdAt            DateTime                        @default(now()) @map("created_at")
  credential           ExternalAccessCredential        @relation("credential_operation_result", fields: [credentialId, tenantId, clientId, scopeKey], references: [id, tenantId, clientId, scopeKey], onDelete: Restrict, onUpdate: Restrict)
  previousCredential   ExternalAccessCredential?       @relation("credential_operation_previous", fields: [previousCredentialId, tenantId, clientId, scopeKey], references: [id, tenantId, clientId, scopeKey], onDelete: Restrict, onUpdate: Restrict)

  @@unique([credentialId, operationKind], map: "external_credential_operations_result_kind_key")
  @@index([tenantId, clientId, venueId, createdAt], map: "external_credential_operations_scope_idx")
  @@map("external_credential_operation_receipts")
}

/// Append-only lineage between an old credential and its replacement.
model ExternalCredentialRotation {
  id                   String                   @id @default(cuid())
  tenantId             String                   @map("tenant_id")
  clientId             String                   @map("client_id")
  venueId              String?                  @map("venue_id")
  scopeKey             String                   @map("scope_key") @db.VarChar(191)
  previousCredentialId String                   @map("previous_credential_id")
  newCredentialId      String                   @map("new_credential_id")
  rotatedBy            String                   @map("rotated_by") @db.VarChar(191)
  rotatedAt            DateTime                 @default(now()) @map("rotated_at")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                Venue?                   @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  previousCredential   ExternalAccessCredential @relation("rotation_from", fields: [previousCredentialId, tenantId, clientId, scopeKey], references: [id, tenantId, clientId, scopeKey], onDelete: Restrict, onUpdate: Restrict)
  newCredential        ExternalAccessCredential @relation("rotation_to", fields: [newCredentialId, tenantId, clientId, scopeKey], references: [id, tenantId, clientId, scopeKey], onDelete: Restrict, onUpdate: Restrict)

  @@unique([previousCredentialId, newCredentialId, tenantId, clientId, scopeKey], map: "external_rotations_pair_scope_key")
  @@unique([previousCredentialId], map: "external_rotations_previous_once_key")
  @@unique([newCredentialId, tenantId, clientId, scopeKey], map: "external_rotations_new_scope_key")
  @@index([tenantId, clientId, venueId, rotatedAt, id], map: "external_rotations_scope_created_idx")
  @@map("external_credential_rotations")
}

/// Append-only evidence for one terminal credential revocation.
model ExternalCredentialRevocation {
  id           String                   @id @default(cuid())
  tenantId     String                   @map("tenant_id")
  clientId     String                   @map("client_id")
  venueId      String?                  @map("venue_id")
  scopeKey     String                   @map("scope_key") @db.VarChar(191)
  credentialId String                   @unique(map: "external_revocations_credential_key") @map("credential_id")
  revokedBy    String                   @map("revoked_by") @db.VarChar(191)
  reasonCode   String                   @map("reason_code") @db.VarChar(100)
  revokedAt    DateTime                 @default(now()) @map("revoked_at")
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue        Venue?                   @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  credential   ExternalAccessCredential @relation(fields: [credentialId, tenantId, clientId, scopeKey], references: [id, tenantId, clientId, scopeKey], onDelete: Restrict, onUpdate: Restrict)

  @@unique([credentialId, tenantId, clientId, scopeKey], map: "external_revocations_exact_scope_key")
  @@index([tenantId, clientId, venueId, revokedAt, id], map: "external_revocations_scope_created_idx")
  @@map("external_credential_revocations")
}

/// Reviewable offboarding intent only. This model does not execute revocations,
/// delete data, enforce retention, or prove completion.
model OffboardingPlan {
  id                        String                        @id @default(cuid())
  tenantId                  String                        @map("tenant_id")
  requestId                 String                        @map("request_id") @db.Uuid
  requestHash               String                        @map("request_hash") @db.Char(64)
  status                    OffboardingPlanStatus         @default(REQUESTED)
  revocationTargets         OffboardingRevocationTarget[] @map("revocation_targets")
  exportKinds               OffboardingExportKind[]       @default([]) @map("export_kinds")
  effectiveAt               DateTime?                     @map("effective_at")
  requestedBy               String                        @map("requested_by") @db.VarChar(191)
  requestedAt               DateTime                      @default(now()) @map("requested_at")
  createdAt                 DateTime                      @default(now()) @map("created_at")
  updatedAt                 DateTime                      @updatedAt @map("updated_at")
  exportReviewOperationId   String?                       @unique(map: "offboarding_plans_export_review_operation_key") @map("export_review_operation_id") @db.Uuid
  exportReviewOperationHash String?                       @map("export_review_operation_hash") @db.Char(64)
  exportReviewedBy          String?                       @map("export_reviewed_by") @db.VarChar(191)
  exportReviewedAt          DateTime?                     @map("export_reviewed_at")
  exportReviewAuditId       String?                       @unique(map: "offboarding_plans_export_review_audit_key") @map("export_review_audit_id")
  tenant                    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venueTargets              OffboardingVenueTarget[]

  @@unique([id, tenantId])
  @@unique([tenantId, requestId], map: "offboarding_plans_tenant_request_key")
  @@index([tenantId, status, requestedAt, id])
  @@map("offboarding_plans")
}

/// Immutable venue scope selected when the draft plan is created.
model OffboardingVenueTarget {
  id                 String                          @id @default(cuid())
  tenantId           String                          @map("tenant_id")
  venueId            String                          @map("venue_id")
  planId             String                          @map("plan_id")
  createdAt          DateTime                        @default(now()) @map("created_at")
  tenant             Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue              Venue                           @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  plan               OffboardingPlan                 @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  revocationEvidence OffboardingRevocationEvidence[]
  exportArtifacts    OffboardingExportArtifact[]
  exportOperations   OffboardingExportOperation[]

  @@unique([planId, tenantId, venueId])
  @@index([tenantId, venueId, createdAt])
  @@map("offboarding_venue_targets")
}

/// Append-only metadata proving a bounded revocation attempt or outcome.
/// This table is not written by the draft/read API introduced with the foundation.
model OffboardingRevocationEvidence {
  id                String                      @id @default(cuid())
  tenantId          String                      @map("tenant_id")
  venueId           String                      @map("venue_id")
  planId            String                      @map("plan_id")
  target            OffboardingRevocationTarget
  outcome           OffboardingEvidenceOutcome
  evidenceReference String                      @map("evidence_reference") @db.VarChar(500)
  errorCode         String?                     @map("error_code") @db.VarChar(100)
  recordedBy        String                      @map("recorded_by") @db.VarChar(191)
  recordedAt        DateTime                    @default(now()) @map("recorded_at")
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venueTarget       OffboardingVenueTarget      @relation(fields: [planId, tenantId, venueId], references: [planId, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId, venueId, planId])
  @@index([tenantId, planId, venueId, recordedAt, id])
  @@map("offboarding_revocation_evidence")
}

/// Append-only export metadata. Artifact bytes remain in the existing storage boundary.
model OffboardingExportArtifact {
  id                String                      @id @default(cuid())
  tenantId          String                      @map("tenant_id")
  venueId           String                      @map("venue_id")
  planId            String                      @map("plan_id")
  kind              OffboardingExportKind
  artifactReference String                      @map("artifact_reference") @db.VarChar(500)
  contentHash       String                      @map("content_hash") @db.Char(64)
  createdBy         String                      @map("created_by") @db.VarChar(191)
  createdAt         DateTime                    @default(now()) @map("created_at")
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venueTarget       OffboardingVenueTarget      @relation(fields: [planId, tenantId, venueId], references: [planId, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  operation         OffboardingExportOperation? @relation(fields: [operationId, tenantId, venueId, planId], references: [id, tenantId, venueId, planId], onDelete: Restrict, onUpdate: Restrict)
  operationId       String?                     @map("operation_id") @db.Uuid

  @@unique([id, tenantId, venueId, planId])
  @@unique([operationId, tenantId, venueId, planId], map: "offboarding_export_artifacts_operation_scope_key")
  @@unique([operationId], map: "offboarding_export_artifacts_operation_key")
  @@index([tenantId, planId, venueId, createdAt, id])
  @@map("offboarding_export_artifacts")
}

/// Durable reservation and settlement evidence for one deterministic export object.
/// Canonical bytes are frozen before storage dispatch; no row performs revocation or deletion.
model OffboardingExportOperation {
  id                    String                           @id @db.Uuid
  tenantId              String                           @map("tenant_id")
  venueId               String                           @map("venue_id")
  planId                String                           @map("plan_id")
  kind                  OffboardingExportKind
  operationHash         String                           @map("operation_hash") @db.Char(64)
  status                OffboardingExportOperationStatus @default(RESERVED)
  canonicalManifest     Json                             @map("canonical_manifest")
  canonicalBytes        String                           @map("canonical_bytes")
  contentHash           String                           @map("content_hash") @db.Char(64)
  byteLength            Int                              @map("byte_length")
  objectKey             String                           @map("object_key") @db.VarChar(500)
  expectedPlanUpdatedAt DateTime                         @map("expected_plan_updated_at")
  requestedBy           String                           @map("requested_by") @db.VarChar(191)
  requestedAt           DateTime                         @map("requested_at")
  storedVersionId       String?                          @map("stored_version_id") @db.VarChar(500)
  storedAt              DateTime?                        @map("stored_at")
  settledAt             DateTime?                        @map("settled_at")
  settlementAuditId     String?                          @unique(map: "offboarding_export_operations_settlement_audit_key") @map("settlement_audit_id")
  tenant                Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venueTarget           OffboardingVenueTarget           @relation(fields: [planId, tenantId, venueId], references: [planId, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  artifact              OffboardingExportArtifact?

  @@unique([id, tenantId, venueId, planId])
  @@unique([tenantId, planId, venueId, kind], map: "offboarding_export_operations_tuple_key")
  @@index([tenantId, planId, status, requestedAt, id])
  @@map("offboarding_export_operations")
}

enum OffboardingExportOperationStatus {
  RESERVED
  STORED
  SETTLED
}

enum OffboardingPlanStatus {
  REQUESTED
  REVIEWED
  REVOCATION_SCHEDULED
  REVOKING
  EXPORT_READY
  COMPLETED
  CANCELLED
}

enum OffboardingRevocationTarget {
  GUEST_LINKS
  WIDGETS
  PARTNER_API_KEYS
  MCP_CREDENTIALS
  BACKGROUND_JOBS
  AGENT_IDENTITIES
  CLIENT_ACCESS
  OPERATOR_IMPERSONATION
}

enum OffboardingEvidenceOutcome {
  COMPLETE
  FAILED
  SKIPPED
}

enum OffboardingExportKind {
  APPROVED_CONTENT
  CONTENT_HISTORY
  VENUE_PACKAGES
  CONFIGURATION
  AUDIT_HISTORY
}

enum SupportRequestStatus {
  OPEN
  WAITING_FOR_CLIENT
  IN_REVIEW
  PATCH_DRAFTED
  VALIDATING
  AWAITING_APPROVAL
  APPLYING
  COMPLETED
  CANCELLED
}

enum SupportRequestCategory {
  CONTENT_CORRECTION
  OPERATIONAL_UPDATE
  BRANDING
  EXPERIENCE_BEHAVIOR
  ACCESSIBILITY
  GENERAL
}

enum SupportParticipantKind {
  CLIENT
  OPERATOR
  AGENT
  SYSTEM
}

enum SupportMessageVisibility {
  CLIENT_VISIBLE
  INTERNAL_ONLY
}
