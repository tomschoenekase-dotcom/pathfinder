  @@index([tenantId, agentRunId, createdAt], map: "agent_questions_run_created_idx")
  @@index([tenantId, venueId, urgency, dueAt], map: "agent_questions_tenant_id_venue_id_urgency_due_at_idx")
  @@index([status, createdAt], map: "agent_questions_status_created_idx")
