enum BillingAgentCommandAction {
  CREATE_NEGOTIATED_CHECKOUT
  SET_GRACE_PERIOD
  CANCEL_AT_PERIOD_END
}

enum BillingAgentCommandStatus {
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  COMPLETED
  REJECTED
  FAILED
}

/// One durable commercial identity for a tenant. Stripe identifiers are
/// namespaced by environment and connected platform account; non-Stripe modes
/// retain no invented provider identity.
model BillingAccount {
  id                       String                      @id @default(cuid())
  tenantId                 String                      @unique @map("tenant_id")
  billingEmail             String?                     @map("billing_email") @db.VarChar(320)
  billingContactReference  String?                     @map("billing_contact_reference") @db.VarChar(191)
  legalNameSnapshot        String?                     @map("legal_name_snapshot") @db.VarChar(191)
  displayNameSnapshot      String                      @map("display_name_snapshot") @db.VarChar(191)
  billingMode              BillingMode                 @map("billing_mode")
  currency                 String                      @default("usd") @db.VarChar(3)
  status                   BillingAccountStatus        @default(UNCONFIGURED)
  stripeMode               StripeEnvironmentMode?      @map("stripe_mode")
  stripeAccountId          String?                     @map("stripe_account_id") @db.VarChar(191)
  stripeCustomerId         String?                     @map("stripe_customer_id") @db.VarChar(191)
  paymentBehavior          Json                        @default("{}") @map("payment_behavior")
  gracePeriodEndsAt        DateTime?                   @map("grace_period_ends_at")
  paidThroughAt            DateTime?                   @map("paid_through_at")
  reconciliationHealth     BillingReconciliationHealth @default(UNKNOWN) @map("reconciliation_health")
  lastReconciledAt         DateTime?                   @map("last_reconciled_at")
  lastReconciliationError  String?                     @map("last_reconciliation_error") @db.VarChar(500)
  internalReference        String?                     @map("internal_reference") @db.VarChar(191)
  internalNotes            String?                     @map("internal_notes") @db.VarChar(2000)
  providerStateChangedAt   DateTime?                   @map("provider_state_changed_at")
  lastAppliedStripeEventId String?                     @map("last_applied_stripe_event_id") @db.VarChar(191)
  lastAppliedStripeEventAt DateTime?                   @map("last_applied_stripe_event_at")
  createdBy                String                      @map("created_by") @db.VarChar(191)
  updatedBy                String                      @map("updated_by") @db.VarChar(191)
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  tenant                   Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commercialAgreements     CommercialAgreement[]
  checkoutAttempts         BillingCheckoutAttempt[]
  invoiceProjections       BillingInvoiceProjection[]
  eventApplications        BillingEventApplication[]
  reconciliationRuns       BillingReconciliationRun[]
  accessOverrides          BillingAccessOverride[]
  customerRequests         BillingCustomerRequest[]
  agentCommands            BillingAgentCommand[]

  @@unique([id, tenantId], map: "billing_accounts_id_tenant_key")
  @@unique([stripeMode, stripeAccountId, stripeCustomerId], map: "billing_accounts_stripe_customer_key")
  @@index([status, reconciliationHealth, updatedAt])
  @@map("billing_accounts")
}

/// Torchiko's commercial arrangement is distinct from the provider's
/// subscription projection. Multiple rows allow future add-ons while isBase
/// identifies the simple launch arrangement.
model CommercialAgreement {
  id                          String                     @id @default(cuid())
  tenantId                    String                     @map("tenant_id")
  billingAccountId            String                     @map("billing_account_id")
  isBase                      Boolean                    @default(false) @map("is_base")
  internalPlanKey             String                     @map("internal_plan_key") @db.VarChar(100)
  internalPlanVersion         Int                        @default(1) @map("internal_plan_version")
  status                      CommercialAgreementStatus  @default(DRAFT)
  billingMode                 BillingMode                @map("billing_mode")
  billingInterval             BillingInterval            @map("billing_interval")
  billingIntervalCount        Int                        @default(1) @map("billing_interval_count")
  quantity                    Int                        @default(1)
  coveredVenueCount           Int                        @default(1) @map("covered_venue_count")
  agreedAmountMinor           BigInt?                    @map("agreed_amount_minor")
  venuePriceBreakdownComplete Boolean                    @default(false) @map("venue_price_breakdown_complete")
  currency                    String                     @default("usd") @db.VarChar(3)
  stripeMode                  StripeEnvironmentMode?     @map("stripe_mode")
  stripeAccountId             String?                    @map("stripe_account_id") @db.VarChar(191)
  stripeProductId             String?                    @map("stripe_product_id") @db.VarChar(191)
  stripePriceId               String?                    @map("stripe_price_id") @db.VarChar(191)
  stripeSubscriptionId        String?                    @map("stripe_subscription_id") @db.VarChar(191)
  stripeSubscriptionStatus    String?                    @map("stripe_subscription_status") @db.VarChar(64)
  startsAt                    DateTime                   @map("starts_at")
  accessStartsAt              DateTime?                  @map("access_starts_at")
  accessEndsAt                DateTime?                  @map("access_ends_at")
  currentPeriodStartsAt       DateTime?                  @map("current_period_starts_at")
  currentPeriodEndsAt         DateTime?                  @map("current_period_ends_at")
  trialStartsAt               DateTime?                  @map("trial_starts_at")
  trialEndsAt                 DateTime?                  @map("trial_ends_at")
  minimumCommitmentStartsAt   DateTime?                  @map("minimum_commitment_starts_at")
  minimumCommitmentEndsAt     DateTime?                  @map("minimum_commitment_ends_at")
  cancelAtPeriodEnd           Boolean                    @default(false) @map("cancel_at_period_end")
  cancellationEffectiveAt     DateTime?                  @map("cancellation_effective_at")
  endedAt                     DateTime?                  @map("ended_at")
  commercialReference         String?                    @map("commercial_reference") @db.VarChar(191)
  providerStateChangedAt      DateTime?                  @map("provider_state_changed_at")
  lastAppliedStripeEventId    String?                    @map("last_applied_stripe_event_id") @db.VarChar(191)
  lastAppliedStripeEventAt    DateTime?                  @map("last_applied_stripe_event_at")
  createdBy                   String                     @map("created_by") @db.VarChar(191)
  updatedBy                   String                     @map("updated_by") @db.VarChar(191)
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")
  tenant                      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingAccount              BillingAccount             @relation(fields: [billingAccountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  coveredVenues               CommercialAgreementVenue[]
  checkoutAttempts            BillingCheckoutAttempt[]
  invoiceProjections          BillingInvoiceProjection[]
  eventApplications           BillingEventApplication[]
