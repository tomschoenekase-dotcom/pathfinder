/// Dedicated encrypted secret storage. Ciphertext is useless without the
/// separately managed integration key; access tokens are never persisted.
model EncryptedIntegrationCredential {
  id                   String    @id @default(cuid())
  provider             String    @db.VarChar(64)
  subject              String    @db.VarChar(320)
  encryptedSecret      Bytes     @map("encrypted_secret")
  initializationVector Bytes     @map("initialization_vector")
  authenticationTag    Bytes     @map("authentication_tag")
  keyVersion           Int       @default(1) @map("key_version")
  createdBy            String    @map("created_by") @db.VarChar(191)
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([provider, subject, revokedAt])
  @@map("encrypted_integration_credentials")
}

/// One-time OAuth state and encrypted PKCE verifier. Attempts are consumed
/// before token exchange so callback replay cannot mint a second credential.
model GmailOAuthAttempt {
  id                    String    @id @default(cuid())
  stateHash             String    @unique @map("state_hash") @db.Char(64)
  encryptedCodeVerifier Bytes     @map("encrypted_code_verifier")
  initializationVector  Bytes     @map("initialization_vector")
  authenticationTag     Bytes     @map("authentication_tag")
  redirectUri           String    @map("redirect_uri") @db.VarChar(1000)
  requestedBy           String    @map("requested_by") @db.VarChar(191)
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([expiresAt, consumedAt])
  @@map("gmail_oauth_attempts")
}

