datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id          String             @id
  email       String             @unique
  fullName    String?            @map("full_name")
  avatarUrl   String?            @map("avatar_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  memberships TenantMembership[]

  @@map("users")
}

model ClerkWebhookReceipt {
  providerEventId          String   @id @map("provider_event_id")
  eventType                String   @map("event_type")
  payloadHash              String   @map("payload_hash")
  welcomeEmailMembershipId String?  @map("welcome_email_membership_id")
  processedAt              DateTime @default(now()) @map("processed_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("clerk_webhook_receipts")
}

enum ClientCreateIntentStatus {
  RESERVED
  PROVIDER_STARTED
  PROVIDER_CONFIRMED
  COMPLETED
}

/// Durable pre-provider fence for platform-admin client creation. The request
/// hash binds caller-supplied setup without storing that setup or credentials.
model ClientCreateIntent {
  id                     String                    @id @default(cuid())
  requestId              String                    @unique @map("request_id") @db.Uuid
  requestHash            String                    @map("request_hash") @db.Char(64)
  actorId                String                    @map("actor_id")
  localSlug              String?                   @map("local_slug")
  status                 ClientCreateIntentStatus  @default(RESERVED)
  providerOrganizationId String?                   @unique @map("provider_organization_id")
  completedTenantId      String?                   @unique @map("completed_tenant_id")
  completedVenueId       String?                   @map("completed_venue_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  events                 ClientCreateIntentEvent[]

  @@index([status, updatedAt])
  @@map("client_create_intents")
}

/// Append-only, sanitized lifecycle evidence for a client-create intent.
model ClientCreateIntentEvent {
  id        String                   @id @default(cuid())
  intentId  String                   @map("intent_id")
  status    ClientCreateIntentStatus
  actorId   String                   @map("actor_id")
  createdAt DateTime                 @default(now()) @map("created_at")
  intent    ClientCreateIntent       @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([intentId, createdAt])
  @@map("client_create_intent_events")
}

model Tenant {
  id                             String                                    @id
  name                           String
  slug                           String                                    @unique
  planTier                       String                                    @default("free") @map("plan_tier")
  status                         TenantStatus                              @default(ACTIVE)
  config                         Json                                      @default("{}")
  nextPaymentDue                 DateTime?                                 @map("next_payment_due")
  engagementMode                 TenantEngagementMode                      @default(STOIC) @map("engagement_mode")
  createdAt                      DateTime                                  @default(now()) @map("created_at")
  updatedAt                      DateTime                                  @updatedAt @map("updated_at")
  memberships                    TenantMembership[]
  featureFlags                   TenantFeatureFlag[]
  venues                         Venue[]
  operationalUpdates             OperationalUpdate[]
  analyticsEvents                AnalyticsEvent[]
  dailyRollups                   DailyRollup[]
  weeklyDigests                  WeeklyDigest[]
  questionClusters               QuestionCluster[]
  engagementQuestions            EngagementQuestion[]
  engagementQuestionResponses    EngagementQuestionResponse[]
  adminChatlogNotes              AdminChatlogNote[]
  weeklyReports                  WeeklyReport[]
  venueReportConfigurations      VenueReportConfiguration[]
  answerAnalysisSnapshots        AnswerAnalysisSnapshot[]
  venueWeeklyThemes              VenueWeeklyTheme[]
  mediaIngestionProjects         MediaIngestionProject[]
  aiUsageEvents                  AiUsageEvent[]
  aiUsageDailyRollups            AiUsageDailyRollup[]
  aiCostBudgets                  AiCostBudget[]
  aiCostReservations             AiCostReservation[]
  embeddingWorkClaims            EmbeddingWorkClaim[]
  embeddingDispatches            EmbeddingDispatch[]
  venueContentImportReceipts     VenueContentImportReceipt[]
  venuePackages                  VenuePackage[]
  venuePackageManifestArtifacts  VenuePackageManifestArtifact[]
  nativeVenueDeploymentReleases  NativeVenueDeploymentRelease[]
  nativeVenueDeploymentArtifacts NativeVenueDeploymentArtifact[]
  nativeVenueDeploymentEffects   NativeVenueDeploymentEffect[]
  nativeVenueDeploymentHeads     NativeVenueDeploymentHead[]
  nativeVenueDeploymentCommands  NativeVenueDeploymentCommand[]
  nativeVenuePublicationLineages NativeVenueDeploymentPublicationLineage[]
  nativeDeploymentEvaluations    NativeVenueDeploymentEvaluationEvidence[]
  venuePackageDuplicateAnalyses  VenuePackageDuplicateAnalysis[]
  generationRequestDispatches    GenerationRequestDispatch[]
  contentVersions                ContentVersion[]
  evalCases                      EvalCase[]
  evalRuns                       EvalRun[]
  evalResults                    EvalResult[]
  evalReviews                    EvalReview[]
  evalRunCostReservations        EvalRunCostReservation[]
  agentIdentities                AgentIdentity[]
  agentRuns                      AgentRun[]
  agentActions                   AgentAction[]
  agentTimelineEvents            AgentTimelineEvent[]
  approvalRequests               ApprovalRequest[]
  approvalDecisions              ApprovalDecision[]
  supportRequests                SupportRequest[]
  supportMessages                SupportMessage[]
  supportAttachments             SupportMessageAttachment[]
  supportAuditEvents             SupportRequestAuditEvent[]
  supportPackageHandoffs         SupportPackageHandoff[]
  supportPreviewFeedback         SupportPreviewFeedback[]
  supportAgentRunLineages        SupportAgentRunLineage[]
  supportRequestParticipants     SupportRequestParticipant[]
  offboardingPlans               OffboardingPlan[]
  offboardingVenueTargets        OffboardingVenueTarget[]
  offboardingRevocationEvidence  OffboardingRevocationEvidence[]
  offboardingExportArtifacts     OffboardingExportArtifact[]
  offboardingExportOperations    OffboardingExportOperation[]
  contentModuleIdentities        ContentModuleIdentity[]
  contentModuleRevisions         ContentModuleRevision[]
  contentModuleEvidence          ContentModuleEvidence[]
  contentModulePublications      ContentModulePublication[]
  intakeRuns                     IntakeRun[]
  intakeEvidence                 IntakeEvidenceRecord[]
  intakeEvents                   IntakeRunEvent[]
  intakePackageHandoffs          IntakePackageHandoff[]
  intakeUploads                  IntakeUpload[]
  externalCredentials            ExternalAccessCredential[]
  credentialRotations            ExternalCredentialRotation[]
  credentialRevocations          ExternalCredentialRevocation[]
  aiConfigurationOverrides       AiScopedWorkloadConfigurationOverride[]
  aiConfigurationHistory         AiScopedWorkloadConfigurationHistory[]

  @@map("tenants")
}

model TenantMembership {
  id                           String                      @id @default(cuid())
  tenantId                     String                      @map("tenant_id")
  userId                       String                      @map("user_id")
  role                         TenantRole
  status                       MembershipStatus            @default(ACTIVE)
  invitedBy                    String?                     @map("invited_by")
  joinedAt                     DateTime?                   @map("joined_at")
  clerkEventTimestamp          BigInt                      @default(dbgenerated("(FLOOR(EXTRACT(EPOCH FROM CURRENT_TIMESTAMP) * 1000))::BIGINT")) @map("clerk_event_timestamp")
  clerkCursorIsCutoverBaseline Boolean                     @default(true) @map("clerk_cursor_is_cutover_baseline")
  welcomeEmailAttemptedAt      DateTime?                   @map("welcome_email_attempted_at")
  welcomeEmailDeliveredAt      DateTime?                   @map("welcome_email_delivered_at")
  createdAt                    DateTime                    @default(now()) @map("created_at")
  updatedAt                    DateTime                    @updatedAt @map("updated_at")
  tenant                       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                         User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  supportRequesters            SupportRequest[]            @relation("support_request_requester_membership")
  supportRequestParticipations SupportRequestParticipant[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  actorId     String   @map("actor_id")
  actorRole   String   @map("actor_role")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model TenantFeatureFlag {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  flagKey  String   @map("flag_key")
  enabled  Boolean  @default(false)
  metadata Json     @default("{}")
  setBy    String   @map("set_by")
  setAt    DateTime @default(now()) @map("set_at")
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

model EngagementQuestion {
  id            String                       @id @default(cuid())
  tenantId      String                       @map("tenant_id")
  questionType  EngagementQuestionType       @map("question_type")
  prompt        String
  choiceOptions String[]                     @default([]) @map("choice_options")
  intensity     Int                          @default(3)
  isActive      Boolean                      @default(true) @map("is_active")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  responses     EngagementQuestionResponse[]

  @@index([tenantId])
  @@map("engagement_questions")
}

model PlatformConfig {
  key       String   @id
  value     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

enum TenantRole {
  OWNER
  MANAGER
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum EngagementQuestionType {
  OPEN_ENDED
  MULTIPLE_CHOICE
}

enum TenantEngagementMode {
  STOIC
  BALANCED
  CURIOUS
}

enum WeeklyReportStatus {
  GENERATING
  DRAFT
  PUBLISHED
  FAILED
}

enum AnswerAnalysisStatus {
  GENERATING
  COMPLETE
  FAILED
}

enum VenuePackageStatus {
  DRAFT
  APPROVED
  APPLIED
  REVERTED
}

model Venue {
  id                                  String                                    @id @default(cuid())
  tenantId                            String                                    @map("tenant_id")
  name                                String
  slug                                String
  description                         String?
  guideNotes                          String?                                   @map("guide_notes")
  aiGuideNotes                        String?                                   @map("ai_guide_notes")
  aiFeaturedPlaceId                   String?                                   @map("ai_featured_place_id")
  aiTone                              String?                                   @default("FRIENDLY") @map("ai_tone")
  tonePreset                          String?                                   @default("friendly") @map("tone_preset")
  tonePresetVersion                   Int?                                      @default(1) @map("tone_preset_version")
  aiGuideName                         String?                                   @map("ai_guide_name")
  chatTheme                           String?                                   @default("default") @map("chat_theme")
  chatAccentColor                     String?                                   @map("chat_accent_color")
  chatFont                            String?                                   @default("jakarta") @map("chat_font")
  chatLogoUrl                         String?                                   @map("chat_logo_url")
  chatBannerUrl                       String?                                   @map("chat_banner_url")
  category                            String?
  guideMode                           String                                    @default("location_aware") @map("guide_mode")
  defaultCenterLat                    Float?                                    @map("default_center_lat")
  defaultCenterLng                    Float?                                    @map("default_center_lng")
  geoBoundary                         Json?                                     @map("geo_boundary")
  isActive                            Boolean                                   @default(true) @map("is_active")
  createdAt                           DateTime                                  @default(now()) @map("created_at")
  updatedAt                           DateTime                                  @updatedAt @map("updated_at")
  tenant                              Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  places                              Place[]
  sessions                            VisitorSession[]
  operationalUpdates                  OperationalUpdate[]
  analyticsEvents                     AnalyticsEvent[]
  dailyRollups                        DailyRollup[]
  questionClusters                    QuestionCluster[]
  knowledgeEntries                    VenueKnowledgeEntry[]
  engagementResponses                 EngagementQuestionResponse[]
  adminChatlogNotes                   AdminChatlogNote[]
  weeklyReports                       WeeklyReport[]
  reportConfiguration                 VenueReportConfiguration?
  answerAnalysisSnapshots             AnswerAnalysisSnapshot[]
  weeklyThemes                        VenueWeeklyTheme[]
  mediaIngestionProjects              MediaIngestionProject[]
  aiUsageEvents                       AiUsageEvent[]
  aiUsageDailyRollups                 AiUsageDailyRollup[]
  aiCostReservations                  AiCostReservation[]
  embeddingWorkClaims                 EmbeddingWorkClaim[]
  embeddingDispatches                 EmbeddingDispatch[]
  contentImportReceipts               VenueContentImportReceipt[]
  venuePackageManifestArtifacts       VenuePackageManifestArtifact[]
  nativeDeploymentReleases            NativeVenueDeploymentRelease[]
  nativeDeploymentArtifacts           NativeVenueDeploymentArtifact[]
  nativeDeploymentEffects             NativeVenueDeploymentEffect[]
  nativeDeploymentHead                NativeVenueDeploymentHead?
  nativeDeploymentCommands            NativeVenueDeploymentCommand[]
  nativeDeploymentPublicationLineages NativeVenueDeploymentPublicationLineage[]
  nativeDeploymentEvaluations         NativeVenueDeploymentEvaluationEvidence[]
  venuePackageDuplicateAnalyses       VenuePackageDuplicateAnalysis[]
  generationRequestDispatches         GenerationRequestDispatch[]
  evalCases                           EvalCase[]
  evalRuns                            EvalRun[]
  evalResults                         EvalResult[]
  evalReviews                         EvalReview[]
  evalRunCostReservations             EvalRunCostReservation[]
  agentIdentities                     AgentIdentity[]
  agentRuns                           AgentRun[]
  agentActions                        AgentAction[]
  agentTimelineEvents                 AgentTimelineEvent[]
  approvalRequests                    ApprovalRequest[]
  approvalDecisions                   ApprovalDecision[]
  supportRequests                     SupportRequest[]
  supportMessages                     SupportMessage[]
  supportAttachments                  SupportMessageAttachment[]
  supportAuditEvents                  SupportRequestAuditEvent[]
  supportPackageHandoffs              SupportPackageHandoff[]
  supportPreviewFeedback              SupportPreviewFeedback[]
  supportAgentRunLineages             SupportAgentRunLineage[]
  supportRequestParticipants          SupportRequestParticipant[]
  offboardingTargets                  OffboardingVenueTarget[]
  contentModuleIdentities             ContentModuleIdentity[]
  contentModuleRevisions              ContentModuleRevision[]
  contentModuleEvidence               ContentModuleEvidence[]
  contentModulePublications           ContentModulePublication[]
  intakeRuns                          IntakeRun[]
  intakeEvidence                      IntakeEvidenceRecord[]
  intakeEvents                        IntakeRunEvent[]
  intakePackageHandoffs               IntakePackageHandoff[]
  intakeUploads                       IntakeUpload[]
  externalCredentials                 ExternalAccessCredential[]
  credentialRotations                 ExternalCredentialRotation[]
  credentialRevocations               ExternalCredentialRevocation[]
  aiConfigurationOverrides            AiScopedWorkloadConfigurationOverride[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("venues")
}

model Place {
  id                 String              @id @default(cuid())
  tenantId           String              @map("tenant_id")
  venueId            String              @map("venue_id")
  name               String
  type               String
  itemType           String?             @map("item_type")
  shortDescription   String?             @map("short_description")
  longDescription    String?             @map("long_description")
  lat                Float?
  lng                Float?
  tags               String[]
  importanceScore    Int                 @default(0) @map("importance_score")
  areaName           String?             @map("area_name")
  hours              String?
  photoUrl           String?             @map("photo_url")
  isActive           Boolean             @default(true) @map("is_active")
  sourceType         String              @default("UNKNOWN") @map("source_type")
  authorship         String              @default("UNKNOWN")
  sourceName         String?             @map("source_name")
  sourceUrl          String?             @map("source_url")
  importedAt         DateTime?           @map("imported_at")
  humanConfirmedAt   DateTime?           @map("human_confirmed_at")
  humanConfirmedBy   String?             @map("human_confirmed_by")
  lastReviewedAt     DateTime?           @map("last_reviewed_at")
  lastReviewedBy     String?             @map("last_reviewed_by")
  sourcePackageId    String?             @map("source_package_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  operationalUpdates OperationalUpdate[]
  analyticsEvents    AnalyticsEvent[]
  dailyRollups       DailyRollup[]
  sourcePackage      VenuePackage?       @relation(fields: [sourcePackageId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  services           ServiceContent[]
  itemContents       ItemContent[]
  events             EventContent[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, venueId])
  @@index([tenantId])
  @@index([venueId])
  @@index([tenantId, sourcePackageId])
  @@map("places")
}

model VenueKnowledgeEntry {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  venueId          String        @map("venue_id")
  title            String
  category         String
  content          String
  isEnabled        Boolean       @default(true) @map("is_enabled")
  sourceType       String        @default("UNKNOWN") @map("source_type")
  authorship       String        @default("UNKNOWN")
  sourceName       String?       @map("source_name")
  sourceUrl        String?       @map("source_url")
  importedAt       DateTime?     @map("imported_at")
  humanConfirmedAt DateTime?     @map("human_confirmed_at")
  humanConfirmedBy String?       @map("human_confirmed_by")
  lastReviewedAt   DateTime?     @map("last_reviewed_at")
  lastReviewedBy   String?       @map("last_reviewed_by")
  sourcePackageId  String?       @map("source_package_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  venue            Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  sourcePackage    VenuePackage? @relation(fields: [sourcePackageId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([venueId])
  @@index([tenantId, sourcePackageId])
  @@map("venue_knowledge_entries")
}

/// Stable identity only; all content payload remains in a typed module table.
model ContentModuleIdentity {
  id                    String                      @id @default(cuid())
  tenantId              String                      @map("tenant_id")
  venueId               String                      @map("venue_id")
  kind                  NormalizedContentModuleKind
  createdAt             DateTime                    @default(now()) @map("created_at")
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                 Venue                       @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  revisions             ContentModuleRevision[]
  publications          ContentModulePublication[]
  outboundRelationships RelationshipContent[]       @relation("relationship_from")
  inboundRelationships  RelationshipContent[]       @relation("relationship_to")

  @@unique([id, tenantId, venueId])
  @@unique([id, tenantId, venueId, kind])
  @@index([tenantId, venueId, kind, createdAt])
  @@map("content_module_identities")
}

/// Append-only version envelope shared by the separate typed module tables.
model ContentModuleRevision {
  id              String                      @id @default(cuid())
  tenantId        String                      @map("tenant_id")
  venueId         String                      @map("venue_id")
  moduleId        String                      @map("module_id")
  kind            NormalizedContentModuleKind
  version         Int
  audience        NormalizedContentAudience
  effectiveFrom   DateTime?                   @map("effective_from")
  effectiveUntil  DateTime?                   @map("effective_until")
  createdBy       String                      @map("created_by") @db.VarChar(191)
  createdAt       DateTime                    @default(now()) @map("created_at")
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue           Venue                       @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  module          ContentModuleIdentity       @relation(fields: [moduleId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)
  evidence        ContentModuleEvidence[]
  publications    ContentModulePublication[]
  service         ServiceContent?
  item            ItemContent?
  policy          PolicyContent?
  event           EventContent?
  operationalFact OperationalFactContent?
  relationship    RelationshipContent?

  @@unique([moduleId, tenantId, venueId, version])
  @@unique([id, tenantId, venueId, kind])
  @@unique([id, tenantId, venueId, moduleId, kind])
  @@index([tenantId, venueId, kind, createdAt])
  @@map("content_module_revisions")
}

model ServiceContent {
  revisionId   String                      @id @map("revision_id")
  tenantId     String                      @map("tenant_id")
  venueId      String                      @map("venue_id")
  kind         NormalizedContentModuleKind @default(SERVICE)
  name         String                      @db.VarChar(200)
  description  String?                     @db.VarChar(10000)
  availability String?                     @db.VarChar(2000)
  placeId      String?                     @map("place_id")
  revision     ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)
  place        Place?                      @relation(fields: [placeId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, tenantId, venueId, kind])
  @@index([tenantId, venueId, name])
  @@map("service_content")
}

model ItemContent {
  revisionId  String                      @id @map("revision_id")
  tenantId    String                      @map("tenant_id")
  venueId     String                      @map("venue_id")
  kind        NormalizedContentModuleKind @default(ITEM)
  name        String                      @db.VarChar(200)
  description String?                     @db.VarChar(10000)
  placeId     String?                     @map("place_id")
  itemType    String                      @map("item_type") @db.VarChar(100)
  revision    ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)
  place       Place?                      @relation(fields: [placeId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, tenantId, venueId, kind])
  @@index([tenantId, venueId, name])
  @@map("item_content")
}

model PolicyContent {
  revisionId String                      @id @map("revision_id")
  tenantId   String                      @map("tenant_id")
  venueId    String                      @map("venue_id")
  kind       NormalizedContentModuleKind @default(POLICY)
  title      String                      @db.VarChar(200)
  rule       String                      @db.VarChar(20000)
  appliesTo  String[]                    @map("applies_to")
  revision   ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, tenantId, venueId, kind])
  @@index([tenantId, venueId, title])
  @@map("policy_content")
}

model EventContent {
  revisionId  String                      @id @map("revision_id")
  tenantId    String                      @map("tenant_id")
  venueId     String                      @map("venue_id")
  kind        NormalizedContentModuleKind @default(EVENT)
  name        String                      @db.VarChar(200)
  description String?                     @db.VarChar(10000)
  startsAt    DateTime                    @map("starts_at")
  endsAt      DateTime?                   @map("ends_at")
  placeId     String?                     @map("place_id")
  revision    ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)
  place       Place?                      @relation(fields: [placeId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, tenantId, venueId, kind])
  @@index([tenantId, venueId, startsAt])
  @@map("event_content")
}

model OperationalFactContent {
  revisionId String                      @id @map("revision_id")
  tenantId   String                      @map("tenant_id")
  venueId    String                      @map("venue_id")
  kind       NormalizedContentModuleKind @default(OPERATIONAL_FACT)
  label      String                      @db.VarChar(200)
  value      String                      @db.VarChar(5000)
  expiresAt  DateTime?                   @map("expires_at")
  revision   ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, tenantId, venueId, kind])
  @@index([tenantId, venueId, label])
  @@map("operational_fact_content")
}

model RelationshipContent {
  revisionId       String                      @id @map("revision_id")
  tenantId         String                      @map("tenant_id")
  venueId          String                      @map("venue_id")
  kind             NormalizedContentModuleKind @default(RELATIONSHIP)
  fromModuleId     String                      @map("from_module_id")
  toModuleId       String                      @map("to_module_id")
  relationshipType String                      @map("relationship_type") @db.VarChar(100)
  description      String?                     @db.VarChar(2000)
  revision         ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)
  fromModule       ContentModuleIdentity       @relation("relationship_from", fields: [fromModuleId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
