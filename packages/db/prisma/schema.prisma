  fileName               String                     @map("file_name") @db.VarChar(255)
  mimeType               String                     @map("mime_type") @db.VarChar(64)
  byteSize               Int                        @map("byte_size")
  sha256                 String                     @db.Char(64)
  objectKey              String                     @unique(map: "intake_uploads_object_key_key") @map("object_key") @db.VarChar(255)
  objectGeneration       String                     @map("object_generation") @db.Uuid
  storageVersionId       String?                    @map("storage_version_id") @db.VarChar(1024)
