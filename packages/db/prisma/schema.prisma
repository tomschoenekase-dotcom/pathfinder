/// Provider-dark case-by-case decision evidence for one Gmail attachment. The
/// request snapshots provider metadata only; approval does not download bytes,
/// import an asset, call Gmail, or establish a retention duration.
model ProspectEmailAttachmentRetentionRequest {
  id                   String                                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationId          String                                   @unique @map("operation_id") @db.Uuid
  emailMessageId       String                                   @map("email_message_id")
  providerAttachmentId String                                   @map("provider_attachment_id") @db.VarChar(512)
