  submissionOperationId String?            @map("submission_operation_id") @db.Uuid
  submissionInputHash   String?            @map("submission_input_hash") @db.Char(64)
  createdAt             DateTime           @default(now()) @map("created_at")
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                 Venue              @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  result                EvalResult         @relation(fields: [resultId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([resultId, revision])
  @@unique([tenantId, submissionOperationId], map: "eval_reviews_tenant_submission_operation_key")
  @@index([tenantId, venueId, createdAt])
  @@map("eval_reviews")
}

