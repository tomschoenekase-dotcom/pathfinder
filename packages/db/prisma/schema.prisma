  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  ENDED
  PAUSED
  MANUAL_REVIEW
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
  CUSTOM
}

enum BillingCheckoutAttemptStatus {
  PENDING
  CREATED
  COMPLETED
  EXPIRED
  CANCELED
  FAILED
}

enum BillingInvoiceSource {
