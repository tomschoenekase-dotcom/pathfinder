model GenerationRequestDispatch {
  id                       String                   @id @default(cuid())
  tenantId                 String                   @map("tenant_id")
  venueId                  String                   @map("venue_id")
  kind                     GenerationRequestKind
  requestId                String?                  @map("request_id") @db.Uuid
  requestHash              String?                  @map("request_hash")
  recordId                 String                   @map("record_id")
  rangeStart               DateTime                 @map("range_start")
  rangeEnd                 DateTime                 @map("range_end")
  status                   GenerationDispatchStatus @default(PENDING)
  attempts                 Int                      @default(0)
  nextAttemptAt            DateTime                 @default(now()) @map("next_attempt_at")
  leaseToken               String?                  @map("lease_token") @db.Uuid
  leaseExpiresAt           DateTime?                @map("lease_expires_at")
  lastError                String?                  @map("last_error")
  consumedAt               DateTime?                @map("consumed_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  answerAnalysisSnapshotId String?                  @unique @map("answer_analysis_snapshot_id")
  weeklyReportId           String?                  @unique @map("weekly_report_id")
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue                    Venue                    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  answerAnalysisSnapshot   AnswerAnalysisSnapshot?  @relation(fields: [answerAnalysisSnapshotId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict)
  weeklyReport             WeeklyReport?            @relation(fields: [weeklyReportId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict)

  @@unique([tenantId, kind, requestId])
  @@unique([tenantId, kind, recordId])
  @@unique([answerAnalysisSnapshotId, tenantId, venueId])
  @@unique([weeklyReportId, tenantId, venueId])
  @@index([status, nextAttemptAt, leaseExpiresAt, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@map("generation_request_dispatches")
}

enum GenerationRequestKind {
  ANSWER_ANALYSIS
  WEEKLY_REPORT
}

enum GenerationDispatchStatus {
  PENDING
  CONSUMED
}

/// Admin-only workspace for turning a venue media archive into reviewed,
/// import-ready PathFinder JSON. Raw media stays in object storage; the DB
/// contains only orchestration state, evidence, questions, and drafts.
model MediaIngestionProject {
  id                 String                @id @default(cuid())
  tenantId           String                @map("tenant_id")
  venueId            String                @map("venue_id")
  name               String
  context            String                @default("")
  mode               MediaIngestionMode    @default(BALANCED)
  status             MediaIngestionStatus  @default(DRAFT)
  stage              String                @default("setup")
  progress           Int                   @default(0)
  sourceObjectKey    String?               @map("source_object_key")
  sourceFileName     String?               @map("source_file_name")
  sourceBytes        BigInt?               @map("source_bytes")
  uploadAttemptId    String?               @map("upload_attempt_id") @db.Uuid
  storageUploadId    String?               @map("storage_upload_id")
  uploadStartedAt    DateTime?             @map("upload_started_at")
  sourceContentType  String?               @map("source_content_type")
  settings           Json                  @default("{}")
  coverage           Json                  @default("{}")
  questions          Json                  @default("[]")
  findings           Json                  @default("[]")
  draftJson          Json?                 @map("draft_json")
  estimatedCostCents Int?                  @map("estimated_cost_cents")
  actualCostCents    Int                   @default(0) @map("actual_cost_cents")
  error              String?
  createdBy          String                @map("created_by")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  completedAt        DateTime?             @map("completed_at")
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue              Venue                 @relation(fields: [venueId], references: [id], onDelete: Restrict)
  assets             MediaIngestionAsset[]

  @@index([tenantId, venueId, createdAt])
  @@index([status, createdAt])
  @@index([status, stage, uploadStartedAt])
  @@map("media_ingestion_projects")
}

model MediaIngestionAsset {
  id         String                    @id @default(cuid())
  tenantId   String                    @map("tenant_id")
  projectId  String                    @map("project_id")
  sourceId   String                    @map("source_id")
  filename   String
  mediaType  MediaIngestionAssetType   @map("media_type")
  objectKey  String                    @map("object_key")
  bytes      BigInt
  sha256     String?
  capturedAt DateTime?                 @map("captured_at")
  status     MediaIngestionAssetStatus @default(PENDING)
  analysis   Json?
  error      String?
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")
  project    MediaIngestionProject     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, sourceId])
  @@index([tenantId, projectId, status])
  @@map("media_ingestion_assets")
}

