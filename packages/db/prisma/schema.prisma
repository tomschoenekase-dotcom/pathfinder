  @@unique([tenantId, venueId, eventType, idempotencyKey], map: "onboarding_milestone_events_replay_key")
  @@index([tenantId, venueId, occurredAt, id], map: "onboarding_milestone_events_timeline_idx")
  @@index([tenantId, eventType, occurredAt], map: "onboarding_milestone_events_rollup_idx")
  @@map("onboarding_milestone_events")
}

/// Append-only human review conclusion. It stores a bounded conclusion, never hidden reasoning.
model EvalReview {
