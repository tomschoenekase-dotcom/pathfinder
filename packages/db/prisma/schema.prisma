  mimeType             String                                   @map("mime_type") @db.VarChar(255)
  sizeBytes            BigInt                                   @map("size_bytes")
  category             ProspectEmailAttachmentRetentionCategory
  purpose              String                                   @db.VarChar(2000)
  sourceReference      String?                                  @map("source_reference") @db.VarChar(1000)
  status               ProspectEmailAttachmentRetentionStatus   @default(AWAITING_REVIEW)
  requestedById        String                                   @map("requested_by_id") @db.VarChar(191)
  reviewOperationId    String?                                  @unique @map("review_operation_id") @db.Uuid
  reviewedById         String?                                  @map("reviewed_by_id") @db.VarChar(191)
  reviewReason         String?                                  @map("review_reason") @db.VarChar(2000)
  reviewedAt           DateTime?                                @map("reviewed_at")
  createdAt            DateTime                                 @default(now()) @map("created_at")
  updatedAt            DateTime                                 @updatedAt @map("updated_at")
  emailMessage         ProspectEmailMessage                     @relation(fields: [emailMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([emailMessageId, createdAt, id], map: "prospect_email_attachment_retention_message_idx")
  @@index([status, createdAt, id], map: "prospect_email_attachment_retention_review_idx")
  @@map("prospect_email_attachment_retention_requests")
}

