  protocolVersion    String                   @map("protocol_version") @db.VarChar(100)
  softwareVersion    String                   @map("software_version") @db.VarChar(100)
  capabilities       String[]                 @default([])
  agentRoles         String[]                 @default([]) @map("agent_roles")
  modelProvider      String?                  @map("model_provider") @db.VarChar(100)
  modelName          String?                  @map("model_name") @db.VarChar(191)
  safeHealth         Json                     @default("{}") @map("safe_health")
  status             AgentWorkerStatus        @default(ONLINE)
  lastHeartbeatAt    DateTime                 @default(now()) @map("last_heartbeat_at")
  leaseExpiresAt     DateTime                 @map("lease_expires_at")
  offlineAt          DateTime?                @map("offline_at")
  registeredAt       DateTime                 @default(now()) @map("registered_at")
