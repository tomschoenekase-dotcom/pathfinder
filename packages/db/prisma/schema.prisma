  primaryObjectId      String?                       @map("primary_object_id") @db.VarChar(191)
  stripeCustomerId     String?                       @map("stripe_customer_id") @db.VarChar(191)
  stripeSubscriptionId String?                       @map("stripe_subscription_id") @db.VarChar(191)
  stripeInvoiceId      String?                       @map("stripe_invoice_id") @db.VarChar(191)
  providerCreatedAt    DateTime                      @map("provider_created_at")
  receivedAt           DateTime                      @default(now()) @map("received_at")
  payloadHash          String                        @map("payload_hash") @db.Char(64)
  sanitizedObject      Json                          @default("{}") @map("sanitized_object")
