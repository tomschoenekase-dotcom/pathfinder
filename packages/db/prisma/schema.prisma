  previewFeedback           SupportPreviewFeedback?
  onboardingQuestionAnswers OnboardingQuestionLink[]
  customerAccessRequests    CustomerAccessRequest[]

  @@unique([id, tenantId, venueId, supportRequestId])
  @@unique([tenantId, submissionRequestId], map: "support_messages_tenant_submission_request_key")
  @@index([tenantId, venueId, supportRequestId, createdAt, id])
  @@map("support_messages")
}

/// Coordination-only bridge between the existing AgentQuestion and Support
/// workflows. It creates no third question engine and grants no approval.
model OnboardingQuestionLink {
  id                        String          @id @default(cuid())
  operationId               String          @map("operation_id") @db.Uuid
  operationHash             String          @map("operation_hash") @db.Char(64)
  tenantId                  String          @map("tenant_id")
  venueId                   String          @map("venue_id")
  agentQuestionId           String          @map("agent_question_id")
  expectedQuestionUpdatedAt DateTime        @map("expected_question_updated_at")
  supportRequestId          String          @map("support_request_id")
  recipientUserId           String          @map("recipient_user_id") @db.VarChar(191)
  answeredSupportMessageId  String?         @map("answered_support_message_id")
  resumedAt                 DateTime?       @map("resumed_at")
  createdBy                 String          @map("created_by") @db.VarChar(191)
  createdAt                 DateTime        @default(now()) @map("created_at")
  tenant                    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                     Venue           @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentQuestion             AgentQuestion   @relation(fields: [agentQuestionId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  supportRequest            SupportRequest  @relation(fields: [supportRequestId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  answeredSupportMessage    SupportMessage? @relation(fields: [answeredSupportMessageId, tenantId, venueId, supportRequestId], references: [id, tenantId, venueId, supportRequestId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, operationId], map: "onboarding_question_links_tenant_operation_key")
  @@unique([agentQuestionId, tenantId, venueId], map: "onboarding_question_links_question_scope_key")
  @@unique([supportRequestId, tenantId, venueId], map: "onboarding_question_links_request_scope_key")
  @@unique([answeredSupportMessageId, tenantId, venueId, supportRequestId], map: "onboarding_question_links_answer_message_key")
  @@index([tenantId, venueId, resumedAt, createdAt], map: "onboarding_question_links_scope_resume_idx")
  @@map("onboarding_question_links")
}

