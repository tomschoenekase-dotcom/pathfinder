  subject                     String                              @db.VarChar(200)
  missingInformation          String[]                            @default([]) @map("missing_information")
  artifacts                   Json                                @default("{}")
  version                     Int                                 @default(1)
  clientVersion               Int                                 @default(1) @map("client_version")
  clientActivityAt            DateTime                            @default(now()) @map("client_activity_at")
  statusChangedAt             DateTime                            @default(now()) @map("status_changed_at")
  createdByKind               SupportParticipantKind              @map("created_by_kind")
  createdById                 String                              @map("created_by_id") @db.VarChar(191)
  requesterUserId             String?                             @map("requester_user_id")
  updatedByKind               SupportParticipantKind              @map("updated_by_kind")
  updatedById                 String                              @map("updated_by_id") @db.VarChar(191)
  createdAt                   DateTime                            @default(now()) @map("created_at")
  updatedAt                   DateTime                            @updatedAt @map("updated_at")
  tenant                      Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
