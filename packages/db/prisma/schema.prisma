/// Immutable message content. Corrections are new messages so the support
/// conversation remains reviewable and client/internal visibility is durable.
model SupportMessage {
  id                  String                     @id @default(cuid())
  tenantId            String                     @map("tenant_id")
  venueId             String                     @map("venue_id")
  supportRequestId    String                     @map("support_request_id")
  authorKind          SupportParticipantKind     @map("author_kind")
  authorId            String                     @map("author_id") @db.VarChar(191)
  visibility          SupportMessageVisibility   @default(CLIENT_VISIBLE)
  body                String
  submissionRequestId String?                    @map("submission_request_id") @db.Uuid
  submissionInputHash String?                    @map("submission_input_hash") @db.Char(64)
  clientVersion       Int?                       @map("client_version")
  requestVersion      Int?                       @map("request_version")
  createdAt           DateTime                   @default(now()) @map("created_at")
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue               Venue                      @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  supportRequest      SupportRequest             @relation(fields: [supportRequestId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
