datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id          String             @id
  email       String             @unique
  fullName    String?            @map("full_name")
  avatarUrl   String?            @map("avatar_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  memberships TenantMembership[]

  @@map("users")
}

model ClerkWebhookReceipt {
  providerEventId          String   @id @map("provider_event_id")
  eventType                String   @map("event_type")
  payloadHash              String   @map("payload_hash")
  welcomeEmailMembershipId String?  @map("welcome_email_membership_id")
  processedAt              DateTime @default(now()) @map("processed_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("clerk_webhook_receipts")
}

/// Default-disabled machine credential for the platform-internal, read-only policy surface.
/// This is deliberately unrelated to tenant/customer MCP credentials.
model PlatformWorkerPolicyCredential {
  id                    String                          @id @default(cuid())
  issueOperationId      String                          @unique @map("issue_operation_id") @db.Uuid
  issueOperationHash    String                          @map("issue_operation_hash") @db.Char(64)
  workerId              String                          @map("worker_id") @db.VarChar(191)
  label                 String                          @db.VarChar(200)
  capabilities          String[]
  secretPrefix          String                          @unique @map("secret_prefix") @db.VarChar(24)
  secretHash            String                          @map("secret_hash") @db.VarChar(255)
  hashAlgorithm         ExternalCredentialHashAlgorithm @default(ARGON2ID) @map("hash_algorithm")
  enabled               Boolean                         @default(false)
  expiresAt             DateTime?                       @map("expires_at")
  revokedAt             DateTime?                       @map("revoked_at")
  lastUsedAt            DateTime?                       @map("last_used_at")
  createdBy             String                          @map("created_by") @db.VarChar(191)
  activatedBy           String?                         @map("activated_by") @db.VarChar(191)
  activatedAt           DateTime?                       @map("activated_at")
  activationOperationId String?                         @unique @map("activation_operation_id") @db.Uuid
  activationHash        String?                         @map("activation_hash") @db.Char(64)
  revokedBy             String?                         @map("revoked_by") @db.VarChar(191)
  revokeReason          String?                         @map("revoke_reason") @db.VarChar(100)
  revocationOperationId String?                         @unique @map("revocation_operation_id") @db.Uuid
  revocationHash        String?                         @map("revocation_hash") @db.Char(64)
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")

  @@index([workerId, enabled, revokedAt], map: "platform_worker_policy_worker_state_idx")
  @@map("platform_worker_policy_credentials")
}

enum ClientCreateIntentStatus {
  RESERVED
  PROVIDER_STARTED
  PROVIDER_CONFIRMED
  COMPLETED
}

/// Durable pre-provider fence for platform-admin client creation. The request
/// hash binds caller-supplied setup without storing that setup or credentials.
model ClientCreateIntent {
  id                     String                    @id @default(cuid())
  requestId              String                    @unique @map("request_id") @db.Uuid
  requestHash            String                    @map("request_hash") @db.Char(64)
  actorId                String                    @map("actor_id")
  localSlug              String?                   @map("local_slug")
  status                 ClientCreateIntentStatus  @default(RESERVED)
  providerOrganizationId String?                   @unique @map("provider_organization_id")
  completedTenantId      String?                   @unique @map("completed_tenant_id")
  completedVenueId       String?                   @map("completed_venue_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  events                 ClientCreateIntentEvent[]

  @@index([status, updatedAt])
  @@map("client_create_intents")
}

/// Append-only, sanitized lifecycle evidence for a client-create intent.
model ClientCreateIntentEvent {
  id        String                   @id @default(cuid())
  intentId  String                   @map("intent_id")
  status    ClientCreateIntentStatus
  actorId   String                   @map("actor_id")
  createdAt DateTime                 @default(now()) @map("created_at")
  intent    ClientCreateIntent       @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([intentId, createdAt])
  @@map("client_create_intent_events")
}

