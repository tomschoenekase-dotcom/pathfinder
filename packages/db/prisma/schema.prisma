  SOLD_OUT_ACTIVITY
  TEMPORARY_VENDOR_LOCATION
}

enum WeeklyDigestStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

/// A tenant-owned machine principal. Access and autonomy are intentionally
/// independent: visibility never implies permission to mutate.
model AgentIdentity {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  venueId            String?            @map("venue_id")
  identityKey        String             @map("identity_key") @db.VarChar(100)
  name               String             @db.VarChar(191)
  description        String?
  agentType          String             @map("agent_type") @db.VarChar(100)
  accessScope        AgentAccessScope   @map("access_scope")
  accessCapabilities String[]           @default([]) @map("access_capabilities")
  autonomyLevel      AgentAutonomyLevel @default(READ_ONLY) @map("autonomy_level")
  autonomousActions  String[]           @default([]) @map("autonomous_actions")
  defaultProvider    String?            @map("default_provider") @db.VarChar(100)
  defaultModel       String?            @map("default_model") @db.VarChar(191)
  enabled            Boolean            @default(false)
  createdBy          String             @map("created_by") @db.VarChar(191)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue              Venue?             @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  runs               AgentRun[]
  actions            AgentAction[]
  approvalRequests   ApprovalRequest[]

  @@unique([tenantId, identityKey])
  @@unique([id, tenantId])
  @@index([tenantId, enabled])
  @@index([tenantId, venueId])
  @@map("agent_identities")
}

model AgentRun {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  venueId            String?              @map("venue_id")
  agentIdentityId    String               @map("agent_identity_id")
  runType            String               @map("run_type") @db.VarChar(100)
  requestedOperation String               @map("requested_operation") @db.VarChar(191)
  scopeSnapshot      Json                 @map("scope_snapshot")
  status             AgentRunStatus       @default(QUEUED)
  modelProvider      String?              @map("model_provider") @db.VarChar(100)
  modelName          String?              @map("model_name") @db.VarChar(191)
  costE8Usd          BigInt               @default(0) @map("cost_e8_usd")
  artifacts          Json                 @default("[]")
  errorCode          String?              @map("error_code") @db.VarChar(100)
  errorMessage       String?              @map("error_message")
  initiatedByType    ActorType            @map("initiated_by_type")
  initiatedById      String               @map("initiated_by_id") @db.VarChar(191)
  cancelRequestedAt  DateTime?            @map("cancel_requested_at")
  startedAt          DateTime?            @map("started_at")
  completedAt        DateTime?            @map("completed_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue              Venue?               @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentIdentity      AgentIdentity        @relation(fields: [agentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actions            AgentAction[]
  timelineEvents     AgentTimelineEvent[]
  approvalRequests   ApprovalRequest[]

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@index([tenantId, agentIdentityId, createdAt])
  @@map("agent_runs")
}

/// Immutable evidence for one attempted domain/tool action. Progress belongs
/// in AgentTimelineEvent; retry creates a new action rather than rewriting history.
model AgentAction {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  venueId            String?              @map("venue_id")
  agentRunId         String               @map("agent_run_id")
  agentIdentityId    String               @map("agent_identity_id")
  approvalDecisionId String?              @map("approval_decision_id")
  actorType          ActorType            @map("actor_type")
  actorId            String               @map("actor_id") @db.VarChar(191)
  requestedOperation String               @map("requested_operation") @db.VarChar(191)
  actionName         String               @map("action_name") @db.VarChar(191)
  inputSummary       String?              @map("input_summary") @db.VarChar(1000)
  inputReference     String?              @map("input_reference") @db.VarChar(500)
  output             Json?
  modelProvider      String?              @map("model_provider") @db.VarChar(100)
  modelName          String?              @map("model_name") @db.VarChar(191)
  costE8Usd          BigInt               @default(0) @map("cost_e8_usd")
  status             AgentActionStatus
  errorCode          String?              @map("error_code") @db.VarChar(100)
  errorMessage       String?              @map("error_message")
  beforeVersionRef   String?              @map("before_version_ref") @db.VarChar(500)
  afterVersionRef    String?              @map("after_version_ref") @db.VarChar(500)
  createdAt          DateTime             @default(now()) @map("created_at")
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue              Venue?               @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentRun           AgentRun             @relation(fields: [agentRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentIdentity      AgentIdentity        @relation(fields: [agentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvalDecision   ApprovalDecision?    @relation(fields: [approvalDecisionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  timelineEvents     AgentTimelineEvent[]

  @@unique([id, tenantId])
  @@unique([approvalDecisionId, tenantId])
  @@index([tenantId, agentRunId, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@index([tenantId, actionName, createdAt])
  @@map("agent_actions")
}

/// Append-only run/action timeline for operator visibility and forensic review.
model AgentTimelineEvent {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  venueId       String?      @map("venue_id")
  agentRunId    String       @map("agent_run_id")
  agentActionId String?      @map("agent_action_id")
  actorType     ActorType    @map("actor_type")
  actorId       String       @map("actor_id") @db.VarChar(191)
  eventType     String       @map("event_type") @db.VarChar(100)
  message       String?      @db.VarChar(1000)
  data          Json         @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue         Venue?       @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentRun      AgentRun     @relation(fields: [agentRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentAction   AgentAction? @relation(fields: [agentActionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, agentRunId, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@map("agent_timeline_events")
}

/// Immutable proposal. Pending is represented by the absence of a decision.
model ApprovalRequest {
  id              String               @id @default(cuid())
  tenantId        String               @map("tenant_id")
  venueId         String?              @map("venue_id")
  agentIdentityId String               @map("agent_identity_id")
  agentRunId      String?              @map("agent_run_id")
  requestedByType ActorType            @map("requested_by_type")
  requestedById   String               @map("requested_by_id") @db.VarChar(191)
  proposedAction  String               @map("proposed_action") @db.VarChar(191)
  scopeSnapshot   Json                 @map("scope_snapshot")
  reason          String               @db.VarChar(2000)
  riskCategory    ApprovalRiskCategory @map("risk_category")
  artifacts       Json                 @default("[]")
  expiresAt       DateTime?            @map("expires_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue           Venue?               @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentIdentity   AgentIdentity        @relation(fields: [agentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentRun        AgentRun?            @relation(fields: [agentRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  decision        ApprovalDecision?

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@index([tenantId, agentIdentityId, createdAt])
  @@map("approval_requests")
}

/// A single append-only terminal decision for an ApprovalRequest. Any action
/// executed under it points back through AgentAction.approvalDecisionId.
model ApprovalDecision {
  id                String                  @id @default(cuid())
  tenantId          String                  @map("tenant_id")
  venueId           String?                 @map("venue_id")
  approvalRequestId String                  @map("approval_request_id")
  decision          ApprovalDecisionOutcome
  decidedByType     ActorType               @map("decided_by_type")
  decidedById       String                  @map("decided_by_id") @db.VarChar(191)
  reason            String?                 @db.VarChar(2000)
  createdAt         DateTime                @default(now()) @map("created_at")
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue             Venue?                  @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvalRequest   ApprovalRequest         @relation(fields: [approvalRequestId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  resultingAction   AgentAction?

  @@unique([id, tenantId])
  @@unique([approvalRequestId, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@map("approval_decisions")
}

