model CompanyKnowledgeItem {
  id                  String                          @id @default(cuid())
  tenantId            String?                         @map("tenant_id")
  venueId             String?                         @map("venue_id")
  organizationId      String?                         @map("organization_id")
  type                CompanyKnowledgeType
  title               String                          @db.VarChar(500)
  summary             String                          @db.VarChar(4000)
  accessScope         CompanyKnowledgeAccessScope     @map("access_scope")
  allowedRoles        String[]                        @default([]) @map("allowed_roles")
  authority           CompanyKnowledgeAuthority
  promotionStatus     CompanyKnowledgePromotionStatus @default(CANDIDATE) @map("promotion_status")
  currentRevision     Int                             @default(1) @map("current_revision")
  contentHash         String                          @map("content_hash") @db.Char(64)
  confidence          Float?
  effectiveAt         DateTime?                       @map("effective_at")
  lastConfirmedAt     DateTime?                       @map("last_confirmed_at")
  supersededAt        DateTime?                       @map("superseded_at")
  supersededById      String?                         @map("superseded_by_id")
  archivedAt          DateTime?                       @map("archived_at")
  createdByType       ActorType                       @map("created_by_type")
  createdById         String                          @map("created_by_id") @db.VarChar(191)
  modelProvider       String?                         @map("model_provider") @db.VarChar(100)
  modelName           String?                         @map("model_name") @db.VarChar(191)
  embeddingSourceHash String?                         @map("embedding_source_hash") @db.Char(64)
  embeddingProfile    String?                         @map("embedding_profile") @db.VarChar(191)
  embeddedAt          DateTime?                       @map("embedded_at")
  idempotencyKey      String                          @unique @map("idempotency_key") @db.VarChar(191)
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  tenant              Tenant?                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue               Venue?                          @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  organization        ProspectOrganization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy        CompanyKnowledgeItem?           @relation("CompanyKnowledgeSupersession", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes          CompanyKnowledgeItem[]          @relation("CompanyKnowledgeSupersession")
  revisions           CompanyKnowledgeRevision[]
  sources             CompanyKnowledgeSource[]
  entityLinks         CompanyKnowledgeEntityLink[]
  outgoingRelations   CompanyKnowledgeRelation[]      @relation("CompanyKnowledgeRelationFrom")
  incomingRelations   CompanyKnowledgeRelation[]      @relation("CompanyKnowledgeRelationTo")
  decision            CompanyDecision?
  priority            CompanyPriority?
  meetingExtractions  CompanyMeetingExtraction[]

