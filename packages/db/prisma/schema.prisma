/// Stable identity only; all content payload remains in a typed module table.
model ContentModuleIdentity {
  id                    String                      @id @default(cuid())
  tenantId              String                      @map("tenant_id")
  venueId               String                      @map("venue_id")
  kind                  NormalizedContentModuleKind
  createdAt             DateTime                    @default(now()) @map("created_at")
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                 Venue                       @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  revisions             ContentModuleRevision[]
  publications          ContentModulePublication[]
  outboundRelationships RelationshipContent[]       @relation("relationship_from")
  inboundRelationships  RelationshipContent[]       @relation("relationship_to")

  @@unique([id, tenantId, venueId])
  @@unique([id, tenantId, venueId, kind])
  @@index([tenantId, venueId, kind, createdAt])
  @@map("content_module_identities")
}

/// Append-only version envelope shared by the separate typed module tables.
model ContentModuleRevision {
  id              String                      @id @default(cuid())
  tenantId        String                      @map("tenant_id")
  venueId         String                      @map("venue_id")
  moduleId        String                      @map("module_id")
  kind            NormalizedContentModuleKind
  version         Int
  audience        NormalizedContentAudience
  effectiveFrom   DateTime?                   @map("effective_from")
  effectiveUntil  DateTime?                   @map("effective_until")
  createdBy       String                      @map("created_by") @db.VarChar(191)
  createdAt       DateTime                    @default(now()) @map("created_at")
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue           Venue                       @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  module          ContentModuleIdentity       @relation(fields: [moduleId, tenantId, venueId, kind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)
  evidence        ContentModuleEvidence[]
  publications    ContentModulePublication[]
  service         ServiceContent?
  item            ItemContent?
  policy          PolicyContent?
  event           EventContent?
  operationalFact OperationalFactContent?
  relationship    RelationshipContent?

  @@unique([moduleId, tenantId, venueId, version])
  @@unique([id, tenantId, venueId, kind])
  @@unique([id, tenantId, venueId, moduleId, kind])
  @@index([tenantId, venueId, kind, createdAt])
  @@map("content_module_revisions")
}

