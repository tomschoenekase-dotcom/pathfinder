  @@unique([id, tenantId])
  @@index([tenantId, status, lastHeartbeatAt], map: "agent_workers_tenant_status_idx")
  @@index([credentialId, status], map: "agent_workers_credential_status_idx")
  @@map("agent_workers")
}

