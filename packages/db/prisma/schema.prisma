model Message {
  id                        String                       @id @default(cuid())
  tenantId                  String                       @map("tenant_id")
  venueId                   String                       @map("venue_id")
  sessionId                 String                       @map("session_id")
  guestChatTurnId           String?                      @map("guest_chat_turn_id") @db.Uuid
  sessionSequence           Int                          @map("session_sequence")
  turnMessageSequence       Int?                         @map("turn_message_sequence")
  role                      MessageRole
  content                   String
  // Fixed-taxonomy topic label, filled nightly by the analytics-enrichment job.
  // Nullable; null means "not yet classified".
  topic                     String?
  createdAt                 DateTime                     @default(now()) @map("created_at")
  session                   VisitorSession               @relation(fields: [sessionId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  guestChatTurn             GuestChatTurn?               @relation("GuestChatTurnMessages", fields: [guestChatTurnId, tenantId, venueId, sessionId], references: [id, tenantId, venueId, sessionId], onDelete: Restrict, onUpdate: Restrict)
  askedEngagementResponses  EngagementQuestionResponse[] @relation("EngagementAskedMessage")
