datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id          String             @id
  email       String             @unique
  fullName    String?            @map("full_name")
  avatarUrl   String?            @map("avatar_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  memberships TenantMembership[]

  @@map("users")
}

model ClerkWebhookReceipt {
  providerEventId          String   @id @map("provider_event_id")
  eventType                String   @map("event_type")
  payloadHash              String   @map("payload_hash")
  welcomeEmailMembershipId String?  @map("welcome_email_membership_id")
  processedAt              DateTime @default(now()) @map("processed_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("clerk_webhook_receipts")
}

model Tenant {
  id                          String                       @id
  name                        String
  slug                        String                       @unique
  planTier                    String                       @default("free") @map("plan_tier")
  status                      TenantStatus                 @default(ACTIVE)
  config                      Json                         @default("{}")
  nextPaymentDue              DateTime?                    @map("next_payment_due")
  engagementMode              TenantEngagementMode         @default(STOIC) @map("engagement_mode")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  memberships                 TenantMembership[]
  featureFlags                TenantFeatureFlag[]
  venues                      Venue[]
  operationalUpdates          OperationalUpdate[]
  analyticsEvents             AnalyticsEvent[]
  dailyRollups                DailyRollup[]
  weeklyDigests               WeeklyDigest[]
  questionClusters            QuestionCluster[]
  engagementQuestions         EngagementQuestion[]
  engagementQuestionResponses EngagementQuestionResponse[]
  adminChatlogNotes           AdminChatlogNote[]
  weeklyReports               WeeklyReport[]
  answerAnalysisSnapshots     AnswerAnalysisSnapshot[]
  venueWeeklyThemes           VenueWeeklyTheme[]
  mediaIngestionProjects      MediaIngestionProject[]
  aiUsageEvents               AiUsageEvent[]
  aiUsageDailyRollups         AiUsageDailyRollup[]
  embeddingWorkClaims         EmbeddingWorkClaim[]
  embeddingDispatches         EmbeddingDispatch[]
  venueContentImportReceipts  VenueContentImportReceipt[]
  generationRequestDispatches GenerationRequestDispatch[]
  contentVersions             ContentVersion[]

  @@map("tenants")
}

model TenantMembership {
  id                           String           @id @default(cuid())
  tenantId                     String           @map("tenant_id")
  userId                       String           @map("user_id")
  role                         TenantRole
  status                       MembershipStatus @default(ACTIVE)
  invitedBy                    String?          @map("invited_by")
  joinedAt                     DateTime?        @map("joined_at")
  clerkEventTimestamp          BigInt           @default(dbgenerated("(FLOOR(EXTRACT(EPOCH FROM CURRENT_TIMESTAMP) * 1000))::BIGINT")) @map("clerk_event_timestamp")
  clerkCursorIsCutoverBaseline Boolean          @default(true) @map("clerk_cursor_is_cutover_baseline")
  welcomeEmailAttemptedAt      DateTime?        @map("welcome_email_attempted_at")
  welcomeEmailDeliveredAt      DateTime?        @map("welcome_email_delivered_at")
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @updatedAt @map("updated_at")
  tenant                       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  actorId     String   @map("actor_id")
  actorRole   String   @map("actor_role")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model TenantFeatureFlag {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  flagKey  String   @map("flag_key")
  enabled  Boolean  @default(false)
  metadata Json     @default("{}")
  setBy    String   @map("set_by")
  setAt    DateTime @default(now()) @map("set_at")
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

model EngagementQuestion {
  id            String                       @id @default(cuid())
  tenantId      String                       @map("tenant_id")
  questionType  EngagementQuestionType       @map("question_type")
  prompt        String
  choiceOptions String[]                     @default([]) @map("choice_options")
  intensity     Int                          @default(3)
  isActive      Boolean                      @default(true) @map("is_active")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  responses     EngagementQuestionResponse[]

  @@index([tenantId])
  @@map("engagement_questions")
}

model PlatformConfig {
  key       String   @id
  value     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

enum TenantRole {
  OWNER
  MANAGER
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum EngagementQuestionType {
  OPEN_ENDED
  MULTIPLE_CHOICE
}

enum TenantEngagementMode {
  STOIC
  BALANCED
  CURIOUS
}

enum WeeklyReportStatus {
  GENERATING
  DRAFT
  PUBLISHED
  FAILED
}

enum AnswerAnalysisStatus {
  GENERATING
  COMPLETE
  FAILED
}

model Venue {
  id                          String                       @id @default(cuid())
  tenantId                    String                       @map("tenant_id")
  name                        String
  slug                        String
  description                 String?
  guideNotes                  String?                      @map("guide_notes")
  aiGuideNotes                String?                      @map("ai_guide_notes")
  aiFeaturedPlaceId           String?                      @map("ai_featured_place_id")
  aiTone                      String?                      @default("FRIENDLY") @map("ai_tone")
  aiGuideName                 String?                      @map("ai_guide_name")
  chatTheme                   String?                      @default("default") @map("chat_theme")
  chatAccentColor             String?                      @map("chat_accent_color")
  chatFont                    String?                      @default("jakarta") @map("chat_font")
  chatLogoUrl                 String?                      @map("chat_logo_url")
  chatBannerUrl               String?                      @map("chat_banner_url")
  category                    String?
  guideMode                   String                       @default("location_aware") @map("guide_mode")
  defaultCenterLat            Float?                       @map("default_center_lat")
  defaultCenterLng            Float?                       @map("default_center_lng")
  geoBoundary                 Json?                        @map("geo_boundary")
  isActive                    Boolean                      @default(true) @map("is_active")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  places                      Place[]
  sessions                    VisitorSession[]
  adapters                    DataAdapter[]
  operationalUpdates          OperationalUpdate[]
  analyticsEvents             AnalyticsEvent[]
  dailyRollups                DailyRollup[]
  questionClusters            QuestionCluster[]
  knowledgeEntries            VenueKnowledgeEntry[]
  engagementResponses         EngagementQuestionResponse[]
  adminChatlogNotes           AdminChatlogNote[]
  weeklyReports               WeeklyReport[]
  answerAnalysisSnapshots     AnswerAnalysisSnapshot[]
  weeklyThemes                VenueWeeklyTheme[]
  mediaIngestionProjects      MediaIngestionProject[]
  aiUsageEvents               AiUsageEvent[]
  aiUsageDailyRollups         AiUsageDailyRollup[]
  embeddingWorkClaims         EmbeddingWorkClaim[]
  embeddingDispatches         EmbeddingDispatch[]
  contentImportReceipts       VenueContentImportReceipt[]
  generationRequestDispatches GenerationRequestDispatch[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("venues")
}

model Place {
  id                 String              @id @default(cuid())
  tenantId           String              @map("tenant_id")
  venueId            String              @map("venue_id")
  name               String
  type               String
  itemType           String?             @map("item_type")
  shortDescription   String?             @map("short_description")
  longDescription    String?             @map("long_description")
  lat                Float?
  lng                Float?
  tags               String[]
  importanceScore    Int                 @default(0) @map("importance_score")
  areaName           String?             @map("area_name")
  hours              String?
  photoUrl           String?             @map("photo_url")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  operationalUpdates OperationalUpdate[]
  analyticsEvents    AnalyticsEvent[]
  dailyRollups       DailyRollup[]

  @@index([tenantId])
  @@index([venueId])
  @@map("places")
}

model VenueKnowledgeEntry {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  venueId   String   @map("venue_id")
  title     String
  category  String
  content   String
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([venueId])
  @@map("venue_knowledge_entries")
}

/// Append-only, database-triggered history for venue, place, knowledge, and
/// operational-update content. Snapshots exclude derived embeddings and mutable
/// update timestamps so background refreshes do not create false revisions.
model ContentVersion {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence              BigInt   @unique @default(autoincrement())
  tenantId              String   @map("tenant_id")
  venueId               String   @map("venue_id")
  entityType            String   @map("entity_type")
  entityId              String   @map("entity_id")
  operation             String
  beforeState           Json?    @map("before_state")
  afterState            Json?    @map("after_state")
  actorId               String?  @map("actor_id")
  revertedFromId        String?  @map("reverted_from_id") @db.Uuid
  snapshotSchemaVersion Int      @default(1) @map("snapshot_schema_version")
  createdAt             DateTime @default(now()) @map("created_at")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, entityType, entityId, sequence])
  @@index([tenantId, entityType, sequence])
  @@index([tenantId, venueId, sequence])
  @@index([revertedFromId])
  @@map("content_versions")
}

/// Durable identity for one venue-content import attempt. The receipt is
/// committed atomically with imported content and stores no imported text.
model VenueContentImportReceipt {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  venueId             String   @map("venue_id")
  idempotencyKey      String   @map("idempotency_key") @db.Uuid
  payloadHash         String   @map("payload_hash") @db.Char(64)
  placeCount          Int      @map("place_count")
  knowledgeEntryCount Int      @map("knowledge_entry_count")
  createdAt           DateTime @default(now()) @map("created_at")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue               Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([tenantId, venueId, idempotencyKey])
  @@index([tenantId, venueId, createdAt])
  @@map("venue_content_import_receipts")
}

model VisitorSession {
  id                              String                       @id @default(cuid())
  tenantId                        String                       @map("tenant_id")
  venueId                         String                       @map("venue_id")
  anonymousToken                  String                       @unique @map("anonymous_token")
  // Persistent per-browser identity (localStorage), distinct from the per-visit
  // anonymousToken (sessionStorage). Drives unique/returning visitor counts.
  // Optional so older clients that don't send it keep working.
  visitorId                       String?                      @map("visitor_id")
  latestLat                       Float?                       @map("latest_lat")
  latestLng                       Float?                       @map("latest_lng")
  startedAt                       DateTime                     @default(now()) @map("started_at")
  lastActiveAt                    DateTime                     @default(now()) @map("last_active_at")
  messageCount                    Int                          @default(0) @map("message_count")
  pendingEngagementQuestionId     String?                      @map("pending_engagement_question_id")
  pendingEngagementIsInvented     Boolean                      @default(false) @map("pending_engagement_is_invented")
  pendingEngagementAskedMessageId String?                      @map("pending_engagement_asked_message_id")
  pendingEngagementAskedAt        DateTime?                    @map("pending_engagement_asked_at")
  isNotable                       Boolean                      @default(false) @map("is_notable")
  venue                           Venue                        @relation(fields: [venueId], references: [id], onDelete: Restrict)
  messages                        Message[]
  engagementResponses             EngagementQuestionResponse[]
  adminNotes                      AdminChatlogNote[]
  aiUsageEvents                   AiUsageEvent[]

  @@unique([venueId, anonymousToken])
  @@index([tenantId])
  @@index([venueId])
  @@index([anonymousToken])
  @@index([visitorId])
  @@index([tenantId, venueId, startedAt])
  @@map("visitor_sessions")
}

model AiUsageEvent {
  id                       String          @id @default(cuid())
  tenantId                 String          @map("tenant_id")
  venueId                  String          @map("venue_id")
  sessionId                String?         @map("session_id")
  feature                  String
  surface                  String
  provider                 String
  model                    String
  pricingVersion           String          @map("pricing_version")
  inputTokens              Int             @default(0) @map("input_tokens")
  outputTokens             Int             @default(0) @map("output_tokens")
  cacheCreationInputTokens Int             @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int             @default(0) @map("cache_read_input_tokens")
  totalTokens              Int             @default(0) @map("total_tokens")
  estimatedCostUsd         Decimal         @default(0) @map("estimated_cost_usd") @db.Decimal(18, 8)
  latencyMs                Int             @map("latency_ms")
  attempts                 Int             @default(1)
  success                  Boolean
  errorCode                String?         @map("error_code")
  createdAt                DateTime        @default(now()) @map("created_at")
  tenant                   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue                    Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  session                  VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@index([sessionId])
  @@index([feature, createdAt])
  @@map("ai_usage_events")
}

model AiUsageDailyRollup {
  id                       String   @id @default(cuid())
  tenantId                 String   @map("tenant_id")
  venueId                  String   @map("venue_id")
  date                     DateTime
  feature                  String
  requestCount             Int      @default(0) @map("request_count")
  successfulRequestCount   Int      @default(0) @map("successful_request_count")
  failedRequestCount       Int      @default(0) @map("failed_request_count")
  inputTokens              Int      @default(0) @map("input_tokens")
  outputTokens             Int      @default(0) @map("output_tokens")
  cacheCreationInputTokens Int      @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int      @default(0) @map("cache_read_input_tokens")
  totalTokens              Int      @default(0) @map("total_tokens")
  estimatedCostUsd         Decimal  @default(0) @map("estimated_cost_usd") @db.Decimal(18, 8)
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue                    Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([tenantId, venueId, date, feature])
  @@index([tenantId, date])
  @@index([tenantId, venueId, date])
  @@index([feature, date])
  @@map("ai_usage_daily_rollups")
}

model EngagementQuestionResponse {
  id                   String                 @id @default(cuid())
  tenantId             String                 @map("tenant_id")
  venueId              String                 @map("venue_id")
  sessionId            String                 @map("session_id")
  engagementQuestionId String?                @map("engagement_question_id")
  isAiInvented         Boolean                @default(false) @map("is_ai_invented")
  answerType           EngagementQuestionType @map("answer_type")
  questionText         String                 @map("question_text")
  askedMessageId       String                 @map("asked_message_id")
  answerMessageId      String                 @map("answer_message_id")
  answerText           String                 @map("answer_text")
  askedAt              DateTime               @map("asked_at")
  answeredAt           DateTime               @map("answered_at")
  sentimentLabel       String?                @map("sentiment_label")
  category             String?
  createdAt            DateTime               @default(now()) @map("created_at")
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue                Venue                  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  session              VisitorSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  engagementQuestion   EngagementQuestion?    @relation(fields: [engagementQuestionId], references: [id], onDelete: SetNull)

  @@index([tenantId, venueId, answeredAt])
  @@index([engagementQuestionId])
  @@index([sessionId])
  @@map("engagement_question_responses")
}

model AdminChatlogNote {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  venueId   String         @map("venue_id")
  sessionId String         @map("session_id")
  authorId  String         @map("author_id")
  note      String
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue     Venue          @relation(fields: [venueId], references: [id], onDelete: Restrict)
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([tenantId, sessionId])
  @@index([venueId, createdAt])
  @@map("admin_chatlog_notes")
}

model Message {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  sessionId String         @map("session_id")
  role      MessageRole
  content   String
  // Fixed-taxonomy topic label, filled nightly by the analytics-enrichment job.
  // Nullable; null means "not yet classified".
  topic     String?
  createdAt DateTime       @default(now()) @map("created_at")
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([sessionId])
  @@index([topic])
  @@map("messages")
}

model DataAdapter {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  venueId     String    @map("venue_id")
  adapterType String    @map("adapter_type")
  configBlob  Json      @default("{}") @map("config_blob")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([venueId])
  @@map("data_adapters")
}

model OperationalUpdate {
  id          String                    @id @default(cuid())
  tenantId    String                    @map("tenant_id")
  venueId     String                    @map("venue_id")
  placeId     String?                   @map("place_id")
  updateType  OperationalUpdateType     @default(GENERAL_NOTICE) @map("update_type")
  severity    OperationalUpdateSeverity
  priority    OperationalUpdatePriority @default(NORMAL)
  title       String
  body        String?
  redirectTo  String?                   @map("redirect_to")
  startsAt    DateTime                  @default(now()) @map("starts_at")
  expiresAt   DateTime                  @map("expires_at")
  status      OperationalUpdateStatus   @default(DRAFT)
  isActive    Boolean                   @default(false) @map("is_active")
  createdBy   String                    @map("created_by")
  publishedBy String?                   @map("published_by")
  publishedAt DateTime?                 @map("published_at")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue       Venue                     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  place       Place?                    @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, venueId, status, isActive, startsAt, expiresAt, priority], map: "operational_updates_guest_visibility_idx")
  @@index([placeId])
  @@map("operational_updates")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  venueId    String   @map("venue_id")
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  placeId    String?  @map("place_id")
  metadata   Json?
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  place      Place?   @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@index([tenantId, venueId, occurredAt])
  @@index([sessionId])
  @@index([eventType, occurredAt])
  @@index([placeId])
  @@map("analytics_events")
}

// Logical replacement uniqueness is enforced by four mutually exclusive partial
// indexes because placeId/category are nullable. See the
// 20260808023000_add_daily_rollup_logical_uniqueness migration.
model DailyRollup {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  venueId  String   @map("venue_id")
  date     DateTime
  metric   String
  placeId  String?  @map("place_id")
  category String?
  value    Int
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  place    Place?   @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@index([tenantId, venueId, date])
  @@index([metric, date])
  @@index([placeId])
  @@map("daily_rollups")
}

// Nightly-computed question clusters per venue/window. Stores both the top-question
// clusters (kind='top_question') and content-gap clusters (kind='content_gap',
// derived from low-confidence flagged questions). The enrichment job replaces a
// venue's rows for each kind/window on every run.
model QuestionCluster {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  venueId       String   @map("venue_id")
  kind          String // 'top_question' | 'content_gap'
  windowStart   DateTime @map("window_start")
  windowEnd     DateTime @map("window_end")
  canonicalText String   @map("canonical_text")
  count         Int
  examples      Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([tenantId, venueId, kind, windowStart])
  @@map("question_clusters")
}

model VenueWeeklyTheme {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  venueId     String   @map("venue_id")
  weekStart   DateTime @map("week_start")
  weekEnd     DateTime @map("week_end")
  // Array of up to 3 { title: string, explanation: string } objects.
  themes      Json     @default("[]")
  generatedAt DateTime @default(now()) @map("generated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@unique([tenantId, venueId, weekStart])
  @@index([tenantId, weekStart])
  @@map("venue_weekly_themes")
}

model JobRecord {
  id                 String                 @id @default(cuid())
  queue              String
  jobName            String                 @map("job_name")
  bullJobId          String?                @unique @map("bull_job_id")
  tenantId           String?                @map("tenant_id")
  status             JobStatus
  payload            Json                   @default("{}")
  error              String?
  attemptNumber      Int?                   @map("attempt_number")
  maxAttempts        Int?                   @map("max_attempts")
  failureDisposition JobFailureDisposition? @map("failure_disposition")
  terminalAt         DateTime?              @map("terminal_at")
  startedAt          DateTime               @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  createdAt          DateTime               @default(now()) @map("created_at")

  @@unique([queue, bullJobId], map: "job_records_queue_bull_job_id_key")
  @@index([queue, status])
  @@index([status, failureDisposition, terminalAt])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("job_records")
}

