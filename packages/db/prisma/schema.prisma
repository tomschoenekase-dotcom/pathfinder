/// Append-only typed provenance for one exact module revision.
model ContentModuleEvidence {
  id          String                      @id @default(cuid())
  tenantId    String                      @map("tenant_id")
  venueId     String                      @map("venue_id")
  revisionId  String                      @map("revision_id")
  moduleKind  NormalizedContentModuleKind @map("module_kind")
  sourceId    String                      @map("source_id") @db.VarChar(500)
  locator     String?                     @db.VarChar(2000)
  capturedAt  DateTime                    @map("captured_at")
  excerptHash String?                     @map("excerpt_hash") @db.Char(64)
  createdAt   DateTime                    @default(now()) @map("created_at")
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue       Venue                       @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  revision    ContentModuleRevision       @relation(fields: [revisionId, tenantId, venueId, moduleKind], references: [id, tenantId, venueId, kind], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, tenantId, venueId, sourceId, locator])
  @@index([tenantId, venueId, revisionId, capturedAt])
  @@map("content_module_evidence")
}

/// Append-only publication ledger. The latest event for a module is the
/// authoritative guest-publication state; authoring a PUBLIC revision alone
/// never publishes it.
model ContentModulePublication {
  id                      String                                   @id @default(cuid())
  tenantId                String                                   @map("tenant_id")
  venueId                 String                                   @map("venue_id")
