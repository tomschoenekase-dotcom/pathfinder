model StripeWebhookReceipt {
  id                   String                        @id @default(cuid())
  stripeMode           StripeEnvironmentMode         @map("stripe_mode")
  stripeAccountId      String                        @map("stripe_account_id") @db.VarChar(191)
  stripeEventId        String                        @map("stripe_event_id") @db.VarChar(191)
  eventType            String                        @map("event_type") @db.VarChar(100)
