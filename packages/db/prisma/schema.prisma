  revokeOperationId    String?                   @map("revoke_operation_id") @db.Uuid
  revokeOperationHash  String?                   @map("revoke_operation_hash") @db.Char(64)
  revokeRequestVersion Int?                      @map("revoke_request_version")
  revokeClientVersion  Int?                      @map("revoke_client_version")
  revokeActionAt       DateTime?                 @map("revoke_action_at")
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                Venue                     @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  request              SupportRequest            @relation(fields: [supportRequestId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict, map: "support_participant_request_fk")
  membership           TenantMembership          @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict, onUpdate: Restrict)
  grantAuditEvent      SupportRequestAuditEvent? @relation("participant_grant_audit", fields: [supportRequestId, tenantId, venueId, grantRequestVersion], references: [supportRequestId, tenantId, venueId, requestVersion], onDelete: Restrict, onUpdate: Restrict, map: "support_participant_grant_audit_fk")
  revokeAuditEvent     SupportRequestAuditEvent? @relation("participant_revoke_audit", fields: [supportRequestId, tenantId, venueId, revokeRequestVersion], references: [supportRequestId, tenantId, venueId, requestVersion], onDelete: Restrict, onUpdate: Restrict, map: "support_participant_revoke_audit_fk")

