  operationId          String                   @map("operation_id") @db.Uuid
  operationHash        String                   @map("operation_hash") @db.Char(64)
  linkedByKind         SupportParticipantKind   @default(OPERATOR) @map("linked_by_kind")
  linkedById           String                   @map("linked_by_id") @db.VarChar(191)
  linkedByRole         String                   @default("PLATFORM_ADMIN") @map("linked_by_role") @db.VarChar(64)
  createdAt            DateTime                 @default(now()) @map("created_at")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                Venue                    @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  supportRequest       SupportRequest           @relation(fields: [supportRequestId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict, map: "support_agent_run_lineages_request_scope_fkey")
  requestEvent         SupportRequestAuditEvent @relation(fields: [supportRequestId, tenantId, venueId, requestVersion], references: [supportRequestId, tenantId, venueId, requestVersion], onDelete: Restrict, onUpdate: Restrict, map: "support_agent_run_lineages_request_event_fkey")
  agentRun             AgentRun                 @relation(fields: [agentRunId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict, map: "support_agent_run_lineages_run_scope_fkey")

  @@unique([tenantId, operationId], map: "support_agent_run_lineages_tenant_operation_key")
  @@unique([agentRunId, tenantId, venueId], map: "support_agent_run_lineages_run_scope_key")
  @@unique([supportRequestId, tenantId, venueId, requestVersion], map: "support_agent_run_lineages_request_version_key")
  @@index([tenantId, venueId, supportRequestId, createdAt, id], map: "support_agent_run_lineages_request_created_idx")
  @@map("support_agent_run_lineages")
}

