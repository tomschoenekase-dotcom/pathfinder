  packageHandoffSupersessions SupportPackageHandoffSupersession[]
  previewFeedback             SupportPreviewFeedback[]
  requesterMembership         TenantMembership?                   @relation("support_request_requester_membership", fields: [tenantId, requesterUserId], references: [tenantId, userId], onDelete: Restrict, onUpdate: Restrict)
  participants                SupportRequestParticipant[]
  agentRunLineages            SupportAgentRunLineage[]
  onboardingQuestionLink      OnboardingQuestionLink?
  clientAssistantHandoff      ClientAssistantSupportHandoff?
  customerAccessRequests      CustomerAccessRequest[]

  @@unique([id, tenantId, venueId])
  @@index([tenantId, venueId, updatedAt, id])
  @@index([tenantId, venueId, createdByKind, createdById, updatedAt, id], map: "support_requests_requester_updated_idx")
  @@index([tenantId, venueId, requesterUserId, clientActivityAt, id], map: "support_requests_requester_activity_idx")
  @@index([tenantId, status, updatedAt])
  @@map("support_requests")
}

model SupportRequestParticipant {
  id                   String                    @id @default(cuid())
  tenantId             String                    @map("tenant_id")
  venueId              String                    @map("venue_id")
  supportRequestId     String                    @map("support_request_id")
  userId               String                    @map("user_id")
  grantOperationId     String                    @map("grant_operation_id") @db.Uuid
  grantOperationHash   String                    @map("grant_operation_hash") @db.Char(64)
  grantRequestVersion  Int?                      @map("grant_request_version")
  grantClientVersion   Int?                      @map("grant_client_version")
