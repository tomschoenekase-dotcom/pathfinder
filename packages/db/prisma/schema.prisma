  intakeUpload     IntakeUpload?  @relation(fields: [intakeUploadId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([supportMessageId, tenantId, venueId, intakeUploadId], map: "support_message_attachments_message_upload_key")
  @@index([tenantId, venueId, supportRequestId, supportMessageId])
  @@map("support_message_attachments")
}

