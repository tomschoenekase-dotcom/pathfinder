  @@unique([tenantId, operationId], map: "agent_improvement_proposals_tenant_operation_key")
  @@unique([tenantId, proposalKey, revision], map: "agent_improvement_proposals_key_revision_key")
  @@index([tenantId, venueId, createdAt, id], map: "agent_improvement_proposals_scope_created_idx")
  @@index([tenantId, agentIdentityId, taskClass, createdAt], map: "agent_improvement_proposals_target_created_idx")
  @@map("agent_improvement_proposals")
}

/// Exact outcome membership for a proposal. This prevents review summaries from
/// becoming detached from the immutable observations that justified them.
model AgentImprovementProposalEvidence {
  tenantId             String                   @map("tenant_id")
  proposalId           String                   @map("proposal_id")
  outcomeObservationId String                   @map("outcome_observation_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proposal             AgentImprovementProposal @relation(fields: [proposalId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  outcomeObservation   AgentOutcomeObservation  @relation(fields: [outcomeObservationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@id([proposalId, outcomeObservationId])
  @@index([tenantId, outcomeObservationId], map: "agent_improvement_evidence_outcome_idx")
  @@map("agent_improvement_proposal_evidence")
}

/// Append-only proof that one approved proposal was implemented at an immutable
/// reference and evaluated against the same corpus/cases. This is evidence only:
/// it never applies the implementation or changes agent authority.
model AgentImprovementValidationEvidence {
  id                    String                             @id @default(cuid())
  operationId           String                             @map("operation_id") @db.Uuid
  tenantId              String                             @map("tenant_id")
  venueId               String                             @map("venue_id")
  proposalId            String                             @map("proposal_id")
  approvalDecisionId    String                             @map("approval_decision_id")
  baselineEvalRunId     String                             @map("baseline_eval_run_id") @db.Uuid
  candidateEvalRunId    String                             @map("candidate_eval_run_id") @db.Uuid
  implementationKind    AgentImprovementImplementationKind @map("implementation_kind")
  implementationRef     String                             @map("implementation_ref") @db.VarChar(500)
  implementationVersion String?                            @map("implementation_version") @db.VarChar(191)
  implementationHash    String                             @map("implementation_hash") @db.Char(64)
  changeDimensions      AgentImprovementChangeDimension[]  @map("change_dimensions")
  comparisonSnapshot    Json                               @map("comparison_snapshot")
  comparisonHash        String                             @map("comparison_hash") @db.Char(64)
  recordedByType        ActorType                          @map("recorded_by_type")
  recordedById          String                             @map("recorded_by_id") @db.VarChar(191)
  createdAt             DateTime                           @default(now()) @map("created_at")
  tenant                Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                 Venue                              @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  proposal              AgentImprovementProposal           @relation(fields: [proposalId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvalDecision      ApprovalDecision                   @relation(fields: [approvalDecisionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  baselineEvalRun       EvalRun                            @relation("AgentImprovementBaselineRun", fields: [baselineEvalRunId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  candidateEvalRun      EvalRun                            @relation("AgentImprovementCandidateRun", fields: [candidateEvalRunId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, operationId], map: "agent_improvement_validations_tenant_operation_key")
  @@unique([proposalId, baselineEvalRunId, candidateEvalRunId, implementationHash], map: "agent_improvement_validations_exact_evidence_key")
  @@index([tenantId, venueId, createdAt, id], map: "agent_improvement_validations_scope_created_idx")
  @@index([tenantId, proposalId, createdAt], map: "agent_improvement_validations_proposal_created_idx")
  @@map("agent_improvement_validation_evidence")
}

/// A single append-only terminal decision for an ApprovalRequest. Any action
/// executed under it points back through AgentAction.approvalDecisionId.
model ApprovalDecision {
  id                          String                               @id @default(cuid())
  tenantId                    String                               @map("tenant_id")
  venueId                     String?                              @map("venue_id")
  approvalRequestId           String                               @map("approval_request_id")
  decision                    ApprovalDecisionOutcome
  decidedByType               ActorType                            @map("decided_by_type")
  decidedById                 String                               @map("decided_by_id") @db.VarChar(191)
  reason                      String?                              @db.VarChar(2000)
  createdAt                   DateTime                             @default(now()) @map("created_at")
  tenant                      Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                       Venue?                               @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvalRequest             ApprovalRequest                      @relation(fields: [approvalRequestId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  resultingAction             AgentAction?
  grant                       ApprovalGrant?
  agentImprovementValidations AgentImprovementValidationEvidence[]

  @@unique([id, tenantId])
  @@unique([approvalRequestId, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, venueId, createdAt])
  @@map("approval_decisions")
}

enum ApprovalGrantMode {
  ONE_SHOT
  BOUNDED
  TEMPORARY
  POLICY_BACKED
}

/// Durable authority derived from one exact human approval or a named reviewed policy.
/// The grant is narrower than an approval decision: it binds the action, capability,
/// agent, scope, parameters/bounds, lifetime, and use count.
model ApprovalGrant {
  id                 String                     @id @default(cuid())
  operationId        String?                    @map("operation_id") @db.Uuid
  tenantId           String                     @map("tenant_id")
  venueId            String                     @map("venue_id")
  approvalDecisionId String?                    @map("approval_decision_id")
  policyKey          String?                    @map("policy_key") @db.VarChar(191)
  agentIdentityId    String                     @map("agent_identity_id")
  actionName         String                     @map("action_name") @db.VarChar(191)
  capability         String                     @db.VarChar(191)
  mode               ApprovalGrantMode
  scope              Json
  parameterHash      String?                    @map("parameter_hash") @db.Char(64)
  constraints        Json                       @default("{}")
  issueReason        String?                    @map("issue_reason") @db.VarChar(2000)
  maxUses            Int?                       @map("max_uses")
  useCount           Int                        @default(0) @map("use_count")
  notBefore          DateTime                   @default(now()) @map("not_before")
  expiresAt          DateTime?                  @map("expires_at")
  revokedAt          DateTime?                  @map("revoked_at")
  revokedByType      ActorType?                 @map("revoked_by_type")
  revokedById        String?                    @map("revoked_by_id") @db.VarChar(191)
  revokeReason       String?                    @map("revoke_reason") @db.VarChar(1000)
  createdByType      ActorType                  @map("created_by_type")
  createdById        String                     @map("created_by_id") @db.VarChar(191)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue              Venue                      @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvalDecision   ApprovalDecision?          @relation(fields: [approvalDecisionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentIdentity      AgentIdentity              @relation(fields: [agentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  consumptions       ApprovalGrantConsumption[]
  authorityEvidence  ApprovalGrantEvidence[]

  @@unique([id, tenantId])
  @@unique([tenantId, operationId], map: "approval_grants_tenant_operation_key")
  @@unique([approvalDecisionId, tenantId], map: "approval_grants_decision_tenant_key")
  @@index([tenantId, venueId, actionName, revokedAt, expiresAt], map: "approval_grants_scope_action_active_idx")
  @@index([tenantId, agentIdentityId, createdAt], map: "approval_grants_agent_created_idx")
  @@map("approval_grants")
}

/// Exact immutable outcome membership reviewed by the human who issued a
/// policy-backed grant. Membership is provenance, not an automatic trust score.
model ApprovalGrantEvidence {
  tenantId             String                  @map("tenant_id")
  approvalGrantId      String                  @map("approval_grant_id")
  outcomeObservationId String                  @map("outcome_observation_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvalGrant        ApprovalGrant           @relation(fields: [approvalGrantId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  outcomeObservation   AgentOutcomeObservation @relation(fields: [outcomeObservationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@id([approvalGrantId, outcomeObservationId])
  @@index([tenantId, outcomeObservationId], map: "approval_grant_evidence_outcome_idx")
  @@map("approval_grant_evidence")
}

/// Append-only evidence for one successful exercise of a grant. Operation IDs
/// make retries return the original evidence instead of consuming authority twice.
model ApprovalGrantConsumption {
  id              String        @id @default(cuid())
  operationId     String        @map("operation_id") @db.Uuid
  tenantId        String        @map("tenant_id")
  venueId         String        @map("venue_id")
  approvalGrantId String        @map("approval_grant_id")
  agentIdentityId String        @map("agent_identity_id")
  agentRunId      String        @map("agent_run_id")
  workerId        String        @map("worker_id") @db.VarChar(191)
  credentialId    String        @map("credential_id") @db.VarChar(191)
  actionName      String        @map("action_name") @db.VarChar(191)
  capability      String        @db.VarChar(191)
  parameterHash   String        @map("parameter_hash") @db.Char(64)
  resultReference String?       @map("result_reference") @db.VarChar(500)
  consumedAt      DateTime      @default(now()) @map("consumed_at")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue           Venue         @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  approvalGrant   ApprovalGrant @relation(fields: [approvalGrantId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentIdentity   AgentIdentity @relation(fields: [agentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  agentRun        AgentRun      @relation(fields: [agentRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, operationId], map: "approval_grant_consumptions_tenant_operation_key")
  @@unique([approvalGrantId, operationId], map: "approval_grant_consumptions_grant_operation_key")
  @@index([tenantId, approvalGrantId, consumedAt], map: "approval_grant_consumptions_grant_time_idx")
  @@index([tenantId, agentRunId, consumedAt], map: "approval_grant_consumptions_run_time_idx")
  @@map("approval_grant_consumptions")
}

