/// One explicitly configured spend envelope for gateway-accounted AI calls.
/// No row (or a disabled row) means enforcement is disabled; there is no
/// invented default commercial threshold.
model AiCostBudget {
  id              String              @id @default(cuid())
  tenantId        String              @map("tenant_id")
  coverageVersion String              @default("gateway-v1") @map("coverage_version") @db.VarChar(32)
  enabled         Boolean             @default(false)
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  limitUnits      BigInt              @map("limit_units")
  remainingUnits  BigInt              @map("remaining_units")
  reservedUnits   BigInt              @default(0) @map("reserved_units")
  committedUnits  BigInt              @default(0) @map("committed_units")
  epoch           Int                 @default(1)
  revision        Int                 @default(1)
  breachedAt      DateTime?           @map("breached_at")
  updatedBy       String              @map("updated_by") @db.VarChar(191)
  reason          String              @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservations    AiCostReservation[]

  @@unique([tenantId, coverageVersion])
  @@unique([id, tenantId])
  @@index([tenantId, enabled])
  @@map("ai_cost_budgets")
}

/// Durable accounting identity for exactly one outbound provider attempt.
/// A process crash or ambiguous provider failure retains the full reservation
/// rather than silently reopening budget capacity.
model AiCostReservation {
  id                String                  @id @db.Uuid
  budgetId          String                  @map("budget_id")
  tenantId          String                  @map("tenant_id")
  venueId           String                  @map("venue_id")
  budgetEpoch       Int                     @map("budget_epoch")
  invocationId      String                  @map("invocation_id") @db.Uuid
  attemptNumber     Int                     @map("attempt_number")
  feature           String                  @db.VarChar(100)
  provider          String                  @db.VarChar(32)
  model             String                  @db.VarChar(191)
  pricingVersion    String                  @map("pricing_version") @db.VarChar(100)
  reservedUnits     BigInt                  @map("reserved_units")
  settledUnits      BigInt?                 @map("settled_units")
  status            AiCostReservationStatus @default(RESERVED)
  settlementKind    AiCostSettlementKind?   @map("settlement_kind")
  expiresAt         DateTime                @map("expires_at")
  dispatchStartedAt DateTime?               @map("dispatch_started_at")
  resolvedAt        DateTime?               @map("resolved_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  budget            AiCostBudget            @relation(fields: [budgetId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue             Venue                   @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([budgetId, budgetEpoch, invocationId, attemptNumber])
  @@index([tenantId, venueId, createdAt])
  @@index([status, expiresAt])
  @@map("ai_cost_reservations")
}

enum EvalRunStatus {
  LEGACY
  STAGED
  QUEUED
  RETRY_SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvalContentSnapshotKind {
  LEGACY_VENUE_CONTENT_V1
  NATIVE_CORE_V1
  APPROVED_VENUE_PACKAGE_V1
  REVIEWABLE_VENUE_PACKAGE_V1
}

enum EvalResultOutcome {
  SCORED
  OPERATIONAL_FAILURE
  ADMISSION_DEFERRED
  BUDGET_BLOCKED
  CANCELLED
}

enum EvalRunCostReservationStatus {
  RESERVED
  SETTLED
  AMBIGUOUS
}

enum EvalReviewDecision {
  ACCEPTED
  REJECTED
  NEEDS_FOLLOW_UP
}

/// Append-only revision of one tenant- and venue-owned deterministic evaluation case.
/// caseKey is the stable logical identity; revision and caseHash identify exact content.
model EvalCase {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                   @map("tenant_id")
  venueId          String                   @map("venue_id")
  caseKey          String                   @map("case_key") @db.VarChar(100)
  revision         Int
  schemaVersion    String                   @map("schema_version") @db.VarChar(64)
  category         String                   @db.VarChar(64)
  caseHash         String                   @map("case_hash") @db.Char(64)
  caseSnapshot     Json                     @map("case_snapshot")
  createdBy        String                   @map("created_by") @db.VarChar(191)
  sourceType       String                   @map("source_type") @db.VarChar(64)
  sourceRef        String                   @map("source_ref") @db.VarChar(500)
  createdAt        DateTime                 @default(now()) @map("created_at")
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue            Venue                    @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  results          EvalResult[]
  costReservations EvalRunCostReservation[]

  @@unique([tenantId, venueId, caseKey, revision])
  @@unique([id, revision, caseHash, tenantId, venueId])
  @@index([tenantId, venueId, category, createdAt])
  @@map("eval_cases")
}

/// Immutable identity and an atomically enforced budget ceiling for one run.
/// One declaredBudgetCeilingE8Usd unit is exactly 10^-8 USD.
/// The helper makes (tenant, venue, idempotencyKey) an exact replay boundary.
model EvalRun {
  id                           String                                    @id @db.Uuid
  tenantId                     String                                    @map("tenant_id")
  venueId                      String                                    @map("venue_id")
  idempotencyKey               String                                    @map("idempotency_key") @db.VarChar(191)
  identityHash                 String                                    @map("identity_hash") @db.Char(64)
  corpusHash                   String                                    @map("corpus_hash") @db.Char(64)
  caseManifestSnapshot         Json                                      @map("case_manifest_snapshot")
  promptContractVersion        String                                    @map("prompt_contract_version") @db.VarChar(64)
  promptContractHash           String                                    @map("prompt_contract_hash") @db.Char(64)
  packageSnapshotRef           String?                                   @map("package_snapshot_ref") @db.VarChar(191)
  packageSnapshotHash          String?                                   @map("package_snapshot_hash") @db.Char(64)
  contentSnapshotKind          EvalContentSnapshotKind                   @default(LEGACY_VENUE_CONTENT_V1) @map("content_snapshot_kind")
  contentSnapshotRef           String?                                   @map("content_snapshot_ref") @db.VarChar(191)
  contentSnapshotVersion       BigInt                                    @map("content_snapshot_version")
  contentSnapshotHash          String                                    @map("content_snapshot_hash") @db.Char(64)
  modelProvider                String                                    @map("model_provider") @db.VarChar(64)
  modelName                    String                                    @map("model_name") @db.VarChar(191)
  modelSnapshotHash            String                                    @map("model_snapshot_hash") @db.Char(64)
  modelSnapshot                Json                                      @map("model_snapshot")
  runConfigSnapshot            Json                                      @map("run_config_snapshot")
  identitySnapshot             Json                                      @map("identity_snapshot")
  declaredBudgetCeilingE8Usd   BigInt                                    @map("declared_budget_ceiling_e8_usd")
  budgetAccountedE8Usd         BigInt                                    @default(0) @map("budget_accounted_e8_usd")
  createdBy                    String                                    @map("created_by") @db.VarChar(191)
  triggerType                  String                                    @map("trigger_type") @db.VarChar(64)
  status                       EvalRunStatus                             @default(STAGED)
  attemptNumber                Int                                       @default(0) @map("attempt_number")
  maxAttempts                  Int?                                      @map("max_attempts")
  startedAt                    DateTime?                                 @map("started_at")
  completedAt                  DateTime?                                 @map("completed_at")
  cancellationRequestedAt      DateTime?                                 @map("cancellation_requested_at")
  cancellationRequestedBy      String?                                   @map("cancellation_requested_by") @db.VarChar(191)
  lastErrorCode                String?                                   @map("last_error_code") @db.VarChar(100)
  executionLeaseToken          String?                                   @map("execution_lease_token") @db.Uuid
  executionLeaseExpiresAt      DateTime?                                 @map("execution_lease_expires_at")
  createdAt                    DateTime                                  @default(now()) @map("created_at")
  tenant                       Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue                        Venue                                     @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  results                      EvalResult[]
  costReservations             EvalRunCostReservation[]
  nativeDeploymentEvidence     NativeVenueDeploymentEvaluationEvidence[]
  improvementBaselineEvidence  AgentImprovementValidationEvidence[]      @relation("AgentImprovementBaselineRun")
  improvementCandidateEvidence AgentImprovementValidationEvidence[]      @relation("AgentImprovementCandidateRun")

  @@unique([tenantId, venueId, idempotencyKey])
  @@unique([id, identityHash, tenantId, venueId])
  @@unique([id, tenantId, venueId], map: "eval_runs_id_tenant_venue_key")
  @@index([tenantId, venueId, createdAt])
  @@index([status, createdAt])
  @@map("eval_runs")
}

/// Durable, conservative provider-call reservation. The unique case boundary means
/// an uncertain call is never dispatched again by a later worker attempt.
model EvalRunCostReservation {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                       @map("tenant_id")
  venueId           String                       @map("venue_id")
  runId             String                       @map("run_id") @db.Uuid
  runIdentityHash   String                       @map("run_identity_hash") @db.Char(64)
  caseId            String                       @map("case_id") @db.Uuid
  caseRevision      Int                          @map("case_revision")
  caseHash          String                       @map("case_hash") @db.Char(64)
  attemptNumber     Int                          @map("attempt_number")
  leaseToken        String?                      @map("lease_token") @db.Uuid
  status            EvalRunCostReservationStatus @default(RESERVED)
  reservedCostE8Usd BigInt                       @map("reserved_cost_e8_usd")
  settledCostE8Usd  BigInt?                      @map("settled_cost_e8_usd")
  resultId          String?                      @unique @map("result_id") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at")
  settledAt         DateTime?                    @map("settled_at")
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue             Venue                        @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  run               EvalRun                      @relation(fields: [runId, runIdentityHash, tenantId, venueId], references: [id, identityHash, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  evalCase          EvalCase                     @relation(fields: [caseId, caseRevision, caseHash, tenantId, venueId], references: [id, revision, caseHash, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  result            EvalResult?                  @relation(fields: [resultId, tenantId, venueId], references: [id, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, venueId, runId, caseId, caseRevision], map: "eval_run_cost_reservations_scope_key")
  @@unique([tenantId, venueId, runId, caseId, caseRevision, attemptNumber], map: "eval_run_cost_reservations_attempt_scope_key")
  @@unique([resultId, tenantId, venueId])
  @@index([tenantId, venueId, runId, status])
  @@map("eval_run_cost_reservations")
}

/// Immutable terminal evidence for one exact case revision in one exact run.
/// Non-scored operational outcomes remain separate from quality pass/fail.
model EvalResult {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                  @map("tenant_id")
  venueId             String                  @map("venue_id")
  runId               String                  @map("run_id") @db.Uuid
  runIdentityHash     String                  @map("run_identity_hash") @db.Char(64)
  caseId              String                  @map("case_id") @db.Uuid
  caseRevision        Int                     @map("case_revision")
  caseHash            String                  @map("case_hash") @db.Char(64)
  outcome             EvalResultOutcome
  observationHash     String?                 @map("observation_hash") @db.Char(64)
  observationSnapshot Json?                   @map("observation_snapshot")
  checksSnapshot      Json?                   @map("checks_snapshot")
  passed              Boolean?
  passedChecks        Int?                    @map("passed_checks")
  totalChecks         Int?                    @map("total_checks")
  errorCode           String?                 @map("error_code") @db.VarChar(100)
  latencyMs           Int                     @map("latency_ms")
  /// One costE8Usd unit is exactly 10^-8 USD.
  costE8Usd           BigInt                  @map("cost_e8_usd")
  createdAt           DateTime                @default(now()) @map("created_at")
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  venue               Venue                   @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  run                 EvalRun                 @relation(fields: [runId, runIdentityHash, tenantId, venueId], references: [id, identityHash, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  evalCase            EvalCase                @relation(fields: [caseId, caseRevision, caseHash, tenantId, venueId], references: [id, revision, caseHash, tenantId, venueId], onDelete: Restrict, onUpdate: Restrict)
  reviews             EvalReview[]
  costReservation     EvalRunCostReservation?

  @@unique([runId, caseId, caseRevision])
  @@unique([id, tenantId, venueId])
  @@index([tenantId, venueId, createdAt])
  @@index([tenantId, runId])
  @@map("eval_results")
}

/// Append-only, sanitized onboarding milestone/outcome evidence. This records
/// domain transitions, never page views, raw conversations, or mutable counters.
model OnboardingMilestoneEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id")
  venueId        String   @map("venue_id")
  eventType      String   @map("event_type") @db.VarChar(64)
  eventVersion   Int      @default(1) @map("event_version")
  idempotencyKey String   @map("idempotency_key") @db.VarChar(191)
  identityHash   String   @map("identity_hash") @db.Char(64)
  occurredAt     DateTime @map("occurred_at")
  actorType      String   @map("actor_type") @db.VarChar(32)
  actorId        String?  @map("actor_id") @db.VarChar(191)
  sourceType     String   @map("source_type") @db.VarChar(64)
  sourceId       String   @map("source_id") @db.VarChar(191)
  sourceRevision String?  @map("source_revision") @db.VarChar(191)
  category       String?  @db.VarChar(100)
  durationMs     Int?     @map("duration_ms")
