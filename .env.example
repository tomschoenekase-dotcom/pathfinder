# Required in production. `production` serves live traffic; `staging` permits
# synthetic staging data; `preview` is for ephemeral review deployments.
RAILWAY_ENVIRONMENT=staging
DATABASE_RESOURCE_ID=db-staging-provider-resource-id
REDIS_RESOURCE_ID=redis-staging-provider-resource-id
STORAGE_RESOURCE_ID=disabled
# Every production worker control must be explicitly set; staging starts fail-closed.
WORKER_SCHEDULERS_ENABLED=false
OUTBOUND_PROVIDER_WORKERS_ENABLED=false
CRM_BACKGROUND_WORKERS_ENABLED=false
INTAKE_UPLOAD_VERIFICATION_WORKERS_ENABLED=false
EVALUATION_RUNNER_ENABLED=false
# Correctness dispatcher: every environment requires explicit opt-in after proof.
EMBEDDING_DISPATCH_ENABLED=false
# Durable generation request dispatcher: every environment requires explicit opt-in.
GENERATION_DISPATCH_ENABLED=false
# Expired generation recovery is default-off everywhere until an explicit canary rollout.
GENERATION_RECOVERY_ENABLED=false
# Errors-only monitoring. Keep disabled until a reviewed staging project exists.
SENTRY_ENABLED=false
SENTRY_DSN=
# Browser and edge monitoring require a separate explicit public opt-in.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
# Build-stamped automatically by Next config; explicit overrides are supported.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=
# Offline navigation fallback is enabled by default. Set false only for a forward retirement deploy.
NEXT_PUBLIC_PWA_ENABLED=true
# Public guest-chat base. Use an exact HTTPS origin with no credentials, path, query, or fragment.
# Plain HTTP is accepted only for explicit localhost/loopback development origins.
NEXT_PUBLIC_WEB_URL=
# Default-off hosted/embed preview. External framing also requires an exact server-only policy.
EMBED_PREVIEW_ENABLED=false
# Provider-neutral voice rollout gate. Tenant/venue entitlement is also required.
VOICE_MODE_ENABLED=false
# Non-secret provider model mappings. Defaults shown match official OpenAI docs on 2026-08-19.
OPENAI_REALTIME_PREMIUM_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_ECONOMY_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Internal generalized-content authoring. Reads/previews remain available while writes fail closed.
GENERALIZED_CONTENT_CAPABILITIES_ENABLED=false
# Server kill switch for the exact per-venue native guest content executor.
# A venue-specific persisted policy and evidence gates are also required.
NATIVE_GUEST_CONTENT_READ_ENABLED=false
# Non-secret bounded JSON: exact venue slug -> exact HTTPS frame origins. Keep server-only.
WIDGET_PREVIEW_ORIGINS_JSON={}
# Optional immutable deployment identifier; Railway/Vercel/GitHub SHA is the fallback.
SENTRY_RELEASE=
# Source-map upload is a separate build-only gate and remains off by default.
SENTRY_SOURCE_MAPS_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_WEB_PROJECT=
SENTRY_DASHBOARD_PROJECT=
DATABASE_URL=
DIRECT_DATABASE_URL=
# Required in production; staging/preview may use the bounded in-process fallback.
REDIS_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MEDIA_ANALYSIS_MODEL=gpt-5.6-luna
MEDIA_SYNTHESIS_MODEL=gpt-5.6-luna
MEDIA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
INTEGRATION_ENCRYPTION_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Resend is transactional/opted-in only; never prospect outreach.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
CRM_CORE_ENABLED=false
CRM_PROSPECT_OUTREACH_ENABLED=false
PROSPECT_OUTREACH_DELIVERY_ENABLED=false
PROSPECT_OUTREACH_RECIPIENT_MODE=internal_allowlist
PROSPECT_OUTREACH_INTERNAL_ALLOWLIST=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_PUSH_AUDIENCE=
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=
GMAIL_WATCH_RENEWAL_ENABLED=false
GMAIL_RECONCILIATION_ENABLED=false
OPERATIONAL_ALERT_DELIVERY_ENABLED=false
OPERATIONAL_ALERT_EMAIL_TO=
OPERATIONAL_ALERT_MIN_SEVERITY=ERROR
OPERATIONAL_ALERT_DEV_SINK_ENABLED=false
# Torchiko Stripe Billing (all launch gates remain off until separately approved)
STRIPE_BILLING_UI_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CUSTOMER_PORTAL_ENABLED=false
STRIPE_CANCELLATION_ENABLED=false
STRIPE_WEBHOOK_PROCESSING_ENABLED=false
STRIPE_RECONCILIATION_ENABLED=false
BILLING_ENTITLEMENT_ENFORCEMENT_ENABLED=false
STRIPE_LIVE_MODE_ALLOWED=false
STRIPE_MODE=test
STRIPE_ACCOUNT_NAMESPACE=torchiko-test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CATALOG_JSON={"catalogVersion":1,"plans":[]}
# STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_...
# Test fixture default only; Tom must approve the production grace policy.
BILLING_GRACE_PERIOD_DAYS=7
