# Required in production. `production` serves live traffic; `staging` permits
# synthetic staging data; `preview` is for ephemeral review deployments.
RAILWAY_ENVIRONMENT=staging
# Defaults to true in production and false in staging/preview.
WORKER_SCHEDULERS_ENABLED=false
# Correctness dispatcher: production defaults on; staging/preview require opt-in after proof.
EMBEDDING_DISPATCH_ENABLED=false
DATABASE_URL=
DIRECT_DATABASE_URL=
# Required in production; staging/preview may use the bounded in-process fallback.
REDIS_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MEDIA_ANALYSIS_MODEL=gpt-5.6-luna
MEDIA_SYNTHESIS_MODEL=gpt-5.6-luna
MEDIA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
INTEGRATION_ENCRYPTION_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
POSTHOG_API_KEY=
RESEND_API_KEY=
